; The debugger consists of three cooperating parts:
;  1. The collector of debug information, which runs inside the assembler thread
;     and records what portions of the output were generated by which lines of source.
;  2. The debugger thread, which starts the assembled program, receives the debug
;     events and controls the execution with breakpoints and tracing.
;  3. The interface, which runs in the main thread, translates the commands of user
;     into the requests for the debugger thread and displays the state of program.

; ----------------------------------------------------------------------------
;  debug information
; ----------------------------------------------------------------------------

reset_debug_info:
; note: called when the assembly is started, discards the information from the previous one
	push	ebx
	xor	eax,eax
	mov	[debug_info_ready],eax
	mov	[debug_info_failed],eax
	mov	[debug_lines_pass],eax
	mov	[debug_lines_count],eax
	mov	[debug_sources_count],eax
	mov	[debug_last_source],eax
	xor	ebx,ebx
    release_debug_files:
	cmp	ebx,[debug_files_count]
	je	debug_files_released
	invoke	HeapFree,[hheap],0,[debug_files+ebx*4]
	inc	ebx
	jmp	release_debug_files
    debug_files_released:
	and	[debug_files_count],0
	call	release_debug_symbols
	pop	ebx
	retn

trace_source_line:
; in: ebx - SourceEntry of the file from which the next line is going to be taken
; preserves: ebx
; note:
;  this is called by the assembler core every time it moves to another line of a source file,
;  the bytes that are generated before the next call are attributed to this line
	cmp	[debug_info_failed],0
	jne	source_line_recorded
	push	ebx
	call	get_output_position
	pop	ebx
	mov	ecx,[current_pass]
	cmp	ecx,[debug_lines_pass]
	je	trace_output_position
	mov	[debug_lines_pass],ecx
	and	[debug_lines_count],0
    trace_output_position:
	mov	ecx,[debug_lines_count]
	mov	edi,[debug_lines]
	jecxz	new_debug_line
	lea	edx,[ecx+ecx*2-3]
	lea	edx,[edi+edx*4]
	cmp	eax,[edx+DebugLine.position]
	je	store_debug_line		; the previous line has not generated anything
    new_debug_line:
	cmp	ecx,[debug_lines_capacity]
	jb	append_debug_line
	push	eax
	mov	eax,[debug_lines_capacity]
	shl	eax,1
	jnz	debug_lines_capacity_ok
	mov	eax,1000h
    debug_lines_capacity_ok:
	push	eax
	imul	eax,sizeof.DebugLine
	test	edi,edi
	jz	allocate_debug_lines
	invoke	HeapReAlloc,[hheap],0,edi,eax
	jmp	debug_lines_allocated
    allocate_debug_lines:
	invoke	HeapAlloc,[hheap],0,eax
    debug_lines_allocated:
	pop	edx
	test	eax,eax
	jz	debug_lines_failed
	mov	[debug_lines],eax
	mov	[debug_lines_capacity],edx
	mov	edi,eax
	mov	ecx,[debug_lines_count]
	pop	eax
    append_debug_line:
	lea	edx,[ecx+ecx*2]
	lea	edx,[edi+edx*4]
	inc	[debug_lines_count]
    store_debug_line:
	assert	sizeof.DebugLine = 12
	mov	[edx+DebugLine.position],eax
	mov	eax,[ebx+SourceEntry.line_number]
	mov	[edx+DebugLine.number],eax
	mov	eax,[ebx+SourceEntry.name]
	mov	[edx+DebugLine.path],eax
    source_line_recorded:
	retn
    debug_lines_failed:
	pop	eax
	mov	[debug_info_failed],1
	retn

collect_debug_info:
; note:
;  called when the assembly is successfully finished, it converts the collected data
;  into a form that stays valid after the assembler releases its resources
	cmp	[debug_info_failed],0
	jne	debug_info_collected
	mov	eax,[current_pass]
	cmp	eax,[debug_lines_pass]
	jne	debug_info_collected
	mov	esi,[debug_lines]
	mov	ecx,[debug_lines_count]
	jecxz	debug_info_collected
	lea	edi,[ecx+ecx*2]
	lea	edi,[esi+edi*4]
	or	eax,-1
    limit_debug_positions:
	; when the position in output moved back (because the reserved data was trimmed),
	; the lines that defined the discarded bytes are left with no contents
	sub	edi,sizeof.DebugLine
	cmp	eax,[edi+DebugLine.position]
	jae	debug_position_ok
	mov	[edi+DebugLine.position],eax
    debug_position_ok:
	mov	eax,[edi+DebugLine.position]
	cmp	edi,esi
	jne	limit_debug_positions
	mov	ebx,[debug_lines_count]
    resolve_debug_paths:
	mov	eax,[esi+DebugLine.path]
	call	get_debug_source
	mov	[esi+DebugLine.path],eax
	add	esi,sizeof.DebugLine
	dec	ebx
	jnz	resolve_debug_paths
	call	collect_debug_symbols
	mov	[debug_info_ready],1
    debug_info_collected:
	retn

get_debug_source:
; in: eax - name of source file, as kept by the assembler
; out: eax - full path to the file in persistent storage, null when not available
; preserves: ebx, esi
	cmp	eax,[debug_last_source]
	je	last_debug_source
	mov	[debug_last_source],eax
	mov	edx,debug_sources
	mov	ecx,[debug_sources_count]
	jecxz	new_debug_source
    find_debug_source:
	cmp	eax,[edx+DebugSource.name]
	je	debug_source_found
	add	edx,sizeof.DebugSource
	loop	find_debug_source
    new_debug_source:
	cmp	[debug_sources_count],MAX_DEBUG_SOURCES
	jae	no_debug_source
	push	ebx esi edi
	mov	edi,edx
	mov	[edi+DebugSource.name],eax
	invoke	GetFullPathName,eax,1000h,debug_path_buffer,debug_file_part
	test	eax,eax
	jz	debug_source_failed
	cmp	eax,1000h
	jae	debug_source_failed
	xor	ebx,ebx
    find_debug_file:
	cmp	ebx,[debug_files_count]
	je	new_debug_file
	invoke	lstrcmpi,[debug_files+ebx*4],debug_path_buffer
	test	eax,eax
	jz	debug_file_found
	inc	ebx
	jmp	find_debug_file
    new_debug_file:
	mov	esi,debug_path_buffer
	call	debug_string_length
	inc	ecx
	push	ecx
	invoke	HeapAlloc,[hheap],0,ecx
	pop	ecx
	test	eax,eax
	jz	debug_source_failed
	mov	[debug_files+ebx*4],eax
	inc	[debug_files_count]
	push	edi
	mov	edi,eax
	rep	movsb
	pop	edi
    debug_file_found:
	mov	eax,[debug_files+ebx*4]
	mov	[edi+DebugSource.path],eax
	inc	[debug_sources_count]
	pop	edi esi ebx
	mov	[debug_last_path],eax
	retn
    debug_source_failed:
	pop	edi esi ebx
    no_debug_source:
	xor	eax,eax
	mov	[debug_last_path],eax
	retn
    debug_source_found:
	mov	eax,[edx+DebugSource.path]
	mov	[debug_last_path],eax
	retn
    last_debug_source:
	mov	eax,[debug_last_path]
	retn

debug_string_length:
; in: esi - ASCIIZ string
; out: ecx = length of string
; preserves: eax, ebx, edx, esi, edi
	or	ecx,-1
    measure_debug_string:
	inc	ecx
	cmp	byte [esi+ecx],0
	jne	measure_debug_string
	retn

release_debug_symbols:
; note: discards the list of labels
	and	[debug_symbols_size],0
	retn

collect_debug_symbols:
; note:
;  makes a list of the labels defined by the assembled program, so that their names can be used to point to
;  the places in memory of the debugged program; every record in the list consists of the value (double word),
;  flags (byte, bit 0 set when the value is relocatable), length of name (byte) and the name
	and	[debug_symbols_size],0
	and	[debug_symbols_depth],0
	mov	ebx,[root_namespace]
	mov	edi,debug_symbol_name

collect_namespace_symbols:
; in: ebx - SymbolTree_Root, edi - end of the name of the namespace
; preserves: edi
	cmp	[debug_symbols_depth],8
	jae	namespace_symbols_collected
	inc	[debug_symbols_depth]
	lea	esi,[ebx+sizeof.SymbolTree_Root]
	mov	ecx,TREE_HEIGHT
	mov	edx,1 shl TREE_NODE_BITS
	test	[ebx+SymbolTree_Root.attributes],SYMTREE_LOCAL
	jz	collect_tree_symbols
	mov	ecx,LOCAL_TREE_HEIGHT
	mov	edx,1 shl LOCAL_TREE_NODE_BITS
      collect_tree_symbols:
	call	collect_node_symbols
	dec	[debug_symbols_depth]
      namespace_symbols_collected:
	retn

collect_node_symbols:
; in: esi - branches of the node, ecx = number of levels left, edx = number of branches, edi - end of the name of the namespace
; preserves: edi
	mov	ebx,edx
      collect_branch_symbols:
	lodsd
	test	eax,eax
	jz	next_symbol_branch
	push	ebx ecx edx esi
	cmp	ecx,1
	je	collect_foliage_symbols
	mov	esi,eax
	dec	ecx
	call	collect_node_symbols
	jmp	symbol_branch_collected
      collect_foliage_symbols:
	mov	ebx,eax
	call	collect_named_symbols
      symbol_branch_collected:
	pop	esi edx ecx ebx
      next_symbol_branch:
	dec	ebx
	jnz	collect_branch_symbols
	retn

collect_named_symbols:
; in: ebx - SymbolTree_Foliage, edi - end of the name of the namespace
; preserves: edi
	cmp	[ebx+SymbolTree_Foliage.name_kind],NAME_CASEINSENSITIVE
	ja	next_named_symbol
	mov	ecx,[ebx+SymbolTree_Foliage.name_length]
	jecxz	next_named_symbol
	lea	eax,[edi+ecx+2]
	cmp	eax,debug_symbol_name+DEBUG_NAME_LENGTH
	jae	next_named_symbol
	push	edi
	mov	esi,[ebx+SymbolTree_Foliage.name_data]
	rep	movsb
	call	collect_symbol
	mov	eax,[ebx+SymbolTree_Foliage.child_namespace]
	test	eax,eax
	jz	nested_symbols_collected
	push	ebx
	mov	ebx,eax
	mov	al,'.'
	stosb
	call	collect_namespace_symbols
	pop	ebx
      nested_symbols_collected:
	pop	edi
      next_named_symbol:
	mov	ebx,[ebx+SymbolTree_Foliage.next]
	test	ebx,ebx
	jnz	collect_named_symbols
	retn

collect_symbol:
; in: ebx - SymbolTree_Foliage, edi - end of the name of the symbol
; preserves: ebx, edi
	lea	edx,[ebx+sizeof.SymbolTree_Foliage]
      find_expression_symbol:
	cmp	[edx+SymbolTree_Leaf.class],SYMCLASS_EXPRESSION
	je	expression_symbol_found
	mov	edx,[edx+SymbolTree_Leaf.next]
	test	edx,edx
	jnz	find_expression_symbol
      symbol_collected:
	retn
      expression_symbol_found:
	test	[edx+SymbolTree_Leaf.flags],SYM_VARIABLE
	jnz	symbol_collected
	mov	edx,[edx+SymbolTree_Leaf.definition]
	test	edx,edx
	jz	symbol_collected
	cmp	[edx+ValueDefinition.type],VALTYPE_NUMERIC
	jne	symbol_collected
	mov	eax,[current_pass]
	cmp	eax,[edx+ValueDefinition.pass]
	jne	symbol_collected
	mov	esi,[edx+ValueDefinition.value]
	lodsd
	mov	ecx,eax
	xor	eax,eax
	cmp	ecx,5
	ja	symbol_collected
	jb	get_symbol_value
	cmp	byte [esi+4],0
	jne	symbol_collected
	mov	eax,[esi]
	jmp	symbol_value_ok
      get_symbol_value:
	jecxz	symbol_value_ok
	push	ecx
	movsx	eax,byte [esi+ecx-1]
      get_symbol_value_byte:
	dec	ecx
	jz	symbol_value_complete
	shl	eax,8
	mov	al,[esi+ecx-1]
	jmp	get_symbol_value_byte
      symbol_value_complete:
	pop	ecx
      symbol_value_ok:
	add	esi,ecx
	xor	dl,dl
	cmp	dword [esi],0
	je	symbol_absolute
	; the value is accepted when it is relative to a single element with a unit coefficient,
	; this is what the addresses in a relocatable program look like
	cmp	dword [esi+4],1
	jne	symbol_collected
	cmp	byte [esi+8],1
	jne	symbol_collected
	cmp	dword [esi+9],0
	jne	symbol_collected
	mov	dl,1
	jmp	store_symbol
      symbol_absolute:
	cmp	eax,10000h
	jb	symbol_collected	; small numbers are not likely to be addresses
      store_symbol:
	mov	ecx,edi
	sub	ecx,debug_symbol_name
	cmp	ecx,100h
	jae	symbol_collected
	push	eax edx ecx
	mov	edx,[debug_symbols_size]
	lea	edx,[edx+ecx+6]
	cmp	edx,[debug_symbols_capacity]
	jbe	symbol_storage_ready
	cmp	edx,1000000h
	jae	symbol_storage_failed
	shl	edx,1
	cmp	edx,10000h
	jae	symbol_storage_size_ok
	mov	edx,10000h
      symbol_storage_size_ok:
	push	edx
	mov	eax,[debug_symbols]
	test	eax,eax
	jz	allocate_symbol_storage
	invoke	HeapReAlloc,[hheap],0,eax,edx
	jmp	symbol_storage_allocated
      allocate_symbol_storage:
	invoke	HeapAlloc,[hheap],0,edx
      symbol_storage_allocated:
	pop	edx
	test	eax,eax
	jz	symbol_storage_failed
	mov	[debug_symbols],eax
	mov	[debug_symbols_capacity],edx
      symbol_storage_ready:
	pop	ecx edx eax
	push	edi
	mov	edi,[debug_symbols]
	add	edi,[debug_symbols_size]
	stosd
	mov	al,dl
	stosb
	mov	al,cl
	stosb
	mov	esi,debug_symbol_name
	rep	movsb
	sub	edi,[debug_symbols]
	mov	[debug_symbols_size],edi
	pop	edi
	retn
      symbol_storage_failed:
	pop	ecx edx eax
	retn

; ----------------------------------------------------------------------------
;  image of the debugged program
; ----------------------------------------------------------------------------

proc DebugLoadImage uses ebx esi edi
; out: eax = zero when the assembled file can be debugged, otherwise pointer to a message
; note: reads the headers of the file to learn how its contents are mapped into memory
	and	[debug_sections_count],0
	cmp	[executable_path],0
	je	.invalid
	invoke	CreateFile,executable_path,GENERIC_READ,FILE_SHARE_READ+FILE_SHARE_WRITE,0,OPEN_EXISTING,0,0
	cmp	eax,-1
	je	.invalid
	mov	ebx,eax
	and	[bytes_count],0
	invoke	ReadFile,ebx,debug_image_header,1000h,bytes_count,0
	invoke	CloseHandle,ebx
	mov	esi,debug_image_header
	mov	ecx,[bytes_count]
	cmp	ecx,40h
	jb	.invalid
	cmp	word [esi],'MZ'
	jne	.invalid
	mov	eax,[esi+3Ch]
	cmp	eax,ecx
	jae	.invalid
	lea	edx,[eax+0F8h]
	cmp	edx,ecx
	ja	.invalid
	add	esi,eax
	cmp	dword [esi],'PE'
	jne	.invalid
	cmp	word [esi+4],14Ch		; IMAGE_FILE_MACHINE_I386
	jne	.unsupported
	cmp	word [esi+18h],10Bh		; IMAGE_NT_OPTIONAL_HDR32_MAGIC
	jne	.unsupported
	test	byte [esi+16h+1],20h		; IMAGE_FILE_DLL
	jnz	.library
	mov	eax,[esi+18h+10h]
	mov	[debug_entry_point],eax
	mov	eax,[esi+18h+1Ch]
	mov	[debug_preferred_base],eax
	mov	eax,[esi+18h+38h]
	mov	[debug_image_size],eax
	movzx	ecx,word [esi+6]
	movzx	edx,word [esi+14h]
	lea	edi,[esi+18h+edx]
	mov	eax,debug_image_header
	add	eax,[bytes_count]
	sub	eax,edi
	jbe	.invalid
	xor	edx,edx
	mov	ebx,40
	div	ebx
	cmp	ecx,eax
	jbe	.sections_ok
	mov	ecx,eax
      .sections_ok:
	mov	[debug_sections],edi
	mov	[debug_sections_count],ecx
	xor	eax,eax
	ret
      .invalid:
	mov	eax,_debug_not_executable
	ret
      .unsupported:
	mov	eax,_debug_not_supported
	ret
      .library:
	mov	eax,_debug_library
	ret
endp

debug_offset_to_address:
; in: eax = offset within the executable file
; out:
;  cf set when the offset is not within the contents of any section
;  when cf = 0:
;   eax = address relative to the base of image
;   edx - header of the section
; preserves: ebx, esi, edi
	mov	edx,[debug_sections]
	mov	ecx,[debug_sections_count]
	jecxz	.not_found
	push	ebx
	mov	ebx,eax
      .check_section:
	mov	eax,ebx
	sub	eax,[edx+14h]
	jc	.next_section
	cmp	eax,[edx+10h]
	jae	.next_section
	add	eax,[edx+0Ch]
	pop	ebx
	clc
	retn
      .next_section:
	add	edx,40
	loop	.check_section
	mov	eax,ebx
	pop	ebx
      .not_found:
	stc
	retn

debug_address_to_offset:
; in: eax = address relative to the base of image
; out:
;  cf set when the address is not within the contents of any section
;  when cf = 0:
;   eax = offset within the executable file
;   edx - header of the section
; preserves: ebx, esi, edi
	mov	edx,[debug_sections]
	mov	ecx,[debug_sections_count]
	jecxz	.not_found
	push	ebx
	mov	ebx,eax
      .check_section:
	mov	eax,ebx
	sub	eax,[edx+0Ch]
	jc	.next_section
	cmp	eax,[edx+10h]
	jae	.next_section
	add	eax,[edx+14h]
	pop	ebx
	clc
	retn
      .next_section:
	add	edx,40
	loop	.check_section
	mov	eax,ebx
	pop	ebx
      .not_found:
	stc
	retn

debug_find_line:
; in: eax = address in the memory of the debugged program
; out:
;  cf set when the address does not belong to the code generated from any line of source
;  when cf = 0:
;   esi - DebugLine
; preserves: ebx, edi
	cmp	[debug_info_ready],0
	je	.not_found
	sub	eax,[debug_image_base]
	call	debug_address_to_offset
	jc	.not_found
	test	byte [edx+24h+3],20h		; IMAGE_SCN_MEM_EXECUTE
	jz	.not_found
	push	ebx edi
	mov	esi,[debug_lines]
	xor	ecx,ecx
	mov	edx,[debug_lines_count]
      .bisect:
	cmp	ecx,edx
	jae	.bisected
	lea	ebx,[ecx+edx]
	shr	ebx,1
	lea	edi,[ebx+ebx*2]
	cmp	[esi+edi*4+DebugLine.position],eax
	ja	.lower_half
	lea	ecx,[ebx+1]
	jmp	.bisect
      .lower_half:
	mov	edx,ebx
	jmp	.bisect
      .bisected:
	pop	edi ebx
	jecxz	.not_found
	lea	ecx,[ecx+ecx*2-3]
	lea	esi,[esi+ecx*4]
	cmp	[esi+DebugLine.path],0
	je	.not_found
	clc
	retn
      .not_found:
	stc
	retn

debug_line_address:
; in: esi - DebugLine
; out:
;  cf set when the line has not generated any executable code
;  when cf = 0:
;   eax = address of the code relative to the base of image
; preserves: ebx, esi, edi
	mov	eax,[debug_lines_count]
	lea	eax,[eax+eax*2]
	shl	eax,2
	add	eax,[debug_lines]
	lea	edx,[esi+sizeof.DebugLine]
	cmp	edx,eax
	jae	.no_code
	mov	eax,[esi+DebugLine.position]
	cmp	eax,[edx+DebugLine.position]
	jae	.no_code
	call	debug_offset_to_address
	jc	.no_code
	test	byte [edx+24h+3],20h		; IMAGE_SCN_MEM_EXECUTE
	jz	.no_code
	clc
	retn
      .no_code:
	stc
	retn

; ----------------------------------------------------------------------------
;  debugger thread
; ----------------------------------------------------------------------------

debug_thread_proc:

	invoke	GetFullPathName,executable_path,1000h,debug_path_buffer,debug_file_part
	mov	edx,[debug_file_part]
	test	edx,edx
	jz	debug_directory_ok
	mov	byte [edx],0
    debug_directory_ok:
	mov	edi,debug_sinfo
	mov	ecx,sizeof.STARTUPINFO shr 2
	xor	eax,eax
	rep	stosd
	mov	[debug_sinfo.cb],sizeof.STARTUPINFO
	invoke	CreateProcess,executable_path,NULL,NULL,NULL,FALSE,DEBUG_ONLY_THIS_PROCESS+NORMAL_PRIORITY_CLASS,NULL,debug_path_buffer,debug_sinfo,debug_pinfo
	test	eax,eax
	jnz	debug_loop
	invoke	GetLastError
	mov	[debug_state],DBGS_NONE
	invoke	PostMessage,[hwnd_main],FM_DEBUG,DBGN_FAILED,eax
	invoke	ExitThread,0

    debug_loop:
	invoke	WaitForDebugEvent,debug_event,DEBUG_POLL_INTERVAL
	test	eax,eax
	jnz	debug_event_received
	xor	eax,eax
	xchg	eax,[debug_request]
	test	eax,eax
	jz	debug_loop
	push	eax
	test	al,DBGR_SYNC
	jz	debug_request_synchronized
	call	debug_update_points
    debug_request_synchronized:
	pop	eax
	test	al,DBGR_STOP
	jnz	debug_terminate
	test	al,DBGR_BREAK
	jz	debug_loop
	cmp	[debug_threads_count],0
	je	debug_loop
	call	debug_suspend_threads
	mov	[debug_suspended],1
	mov	eax,[debug_threads]		; the initial thread of the process, unless it has ended already
	mov	[debug_thread_id],eax
	mov	eax,[debug_threads+4]
	mov	[debug_thread],eax
	call	debug_get_context
	mov	eax,DBGP_BREAK
	jmp	debug_pause
    debug_terminate:
	invoke	TerminateProcess,[debug_pinfo.hProcess],0
	jmp	debug_loop

    debug_event_received:
	mov	[debug_continue_status],DBG_CONTINUE
	mov	eax,[debug_event.dwDebugEventCode]
	cmp	eax,EXCEPTION_DEBUG_EVENT
	je	debug_exception
	cmp	eax,CREATE_THREAD_DEBUG_EVENT
	je	debug_thread_created
	cmp	eax,CREATE_PROCESS_DEBUG_EVENT
	je	debug_process_created
	cmp	eax,EXIT_THREAD_DEBUG_EVENT
	je	debug_thread_exited
	cmp	eax,EXIT_PROCESS_DEBUG_EVENT
	je	debug_process_exited
	cmp	eax,LOAD_DLL_DEBUG_EVENT
	je	debug_library_loaded
	cmp	eax,OUTPUT_DEBUG_STRING_EVENT
	je	debug_string_received
    debug_continue:
	invoke	ContinueDebugEvent,[debug_event.dwProcessId],[debug_event.dwThreadId],[debug_continue_status]
	jmp	debug_loop

    debug_process_created:
	mov	eax,[debug_event.NewProcess.lpBaseOfImage]
	mov	[debug_image_base],eax
	mov	eax,[debug_event.dwThreadId]
	mov	edx,[debug_event.NewProcess.hThread]
	call	debug_add_thread
	mov	eax,[debug_event.NewProcess.hFile]
	test	eax,eax
	jz	debug_process_ready
	invoke	CloseHandle,eax
    debug_process_ready:
	call	debug_update_points
	call	debug_set_temporary_points
	cmp	[debug_break_at_entry],0
	je	debug_continue
	mov	eax,[debug_entry_point]
	add	eax,[debug_image_base]
	mov	dl,DBP_TEMPORARY
	call	debug_set_point
	jmp	debug_continue

    debug_thread_created:
	mov	eax,[debug_event.dwThreadId]
	mov	edx,[debug_event.NewThread.hThread]
	call	debug_add_thread
	jmp	debug_continue

    debug_thread_exited:
	mov	eax,[debug_event.dwThreadId]
	call	debug_remove_thread
	jmp	debug_continue

    debug_library_loaded:
	mov	eax,[debug_event.Module.hFile]
	test	eax,eax
	jz	debug_continue
	invoke	CloseHandle,eax
	jmp	debug_continue

    debug_string_received:
	cmp	[debug_event.DebugString.fUnicode],0
	jne	debug_continue
	movzx	ebx,[debug_event.DebugString.nDebugStringLength]
	test	ebx,ebx
	jz	debug_continue
	lea	eax,[ebx+1]
	invoke	HeapAlloc,[hheap],0,eax
	test	eax,eax
	jz	debug_continue
	mov	edi,eax
	mov	esi,[debug_event.DebugString.lpDebugStringData]
	mov	ecx,ebx
	call	debug_read_memory
	jc	debug_string_unavailable
	mov	byte [edi+ebx],0
	invoke	PostMessage,[hwnd_main],FM_DEBUG,DBGN_OUTPUT,edi
	jmp	debug_continue
    debug_string_unavailable:
	invoke	HeapFree,[hheap],0,edi
	jmp	debug_continue

    debug_process_exited:
	mov	eax,[debug_event.dwExitCode]
	mov	[debug_exit_code],eax
	invoke	ContinueDebugEvent,[debug_event.dwProcessId],[debug_event.dwThreadId],DBG_CONTINUE
	invoke	CloseHandle,[debug_pinfo.hThread]
	invoke	CloseHandle,[debug_pinfo.hProcess]
	mov	[debug_state],DBGS_NONE
	invoke	PostMessage,[hwnd_main],FM_DEBUG,DBGN_EXITED,[debug_exit_code]
	invoke	ExitThread,0

    debug_exception:
	mov	eax,[debug_event.dwThreadId]
	mov	[debug_thread_id],eax
	call	debug_find_thread
	mov	[debug_thread],eax
	mov	eax,[debug_event.Exception.ExceptionCode]
	cmp	eax,EXCEPTION_BREAKPOINT
	je	debug_breakpoint
	cmp	eax,EXCEPTION_SINGLE_STEP
	je	debug_single_step
	call	debug_get_context
	mov	eax,[debug_thread_id]
	call	debug_end_pass
	jc	debug_exception_context_ok
	; the instruction that was being traced has not been completed
	and	[debug_context.regFlag],not EFLAGS_TF
	call	debug_set_context
    debug_exception_context_ok:
	mov	[debug_continue_status],DBG_EXCEPTION_NOT_HANDLED
	cmp	[debug_event.Exception.dwFirstChance],0
	je	debug_exception_stop
	mov	eax,[debug_event.Exception.ExceptionCode]
	and	eax,0F0000000h
	cmp	eax,0C0000000h
	jne	debug_continue		; only the errors are intercepted before the program has a chance to handle them
    debug_exception_stop:
	mov	eax,DBGP_EXCEPTION
	jmp	debug_pause

    debug_breakpoint:
	mov	eax,[debug_event.Exception.ExceptionAddress]
	call	debug_find_point
	jc	debug_unknown_breakpoint
	cmp	[ebx+DebugPoint.lifted],0
	jne	debug_unknown_breakpoint
	call	debug_get_context
	mov	eax,[debug_thread_id]
	call	debug_end_pass
	mov	eax,[ebx+DebugPoint.address]
	mov	[debug_context.regEip],eax
	and	[debug_context.regFlag],not EFLAGS_TF
	call	debug_set_context
	mov	al,[ebx+DebugPoint.flags]
	test	al,DBP_USER
	jnz	debug_user_breakpoint
	test	al,DBP_TEMPORARY
	jnz	debug_temporary_breakpoint
	test	al,DBP_STEP
	jz	debug_pass_breakpoint
	mov	eax,[debug_thread_id]
	cmp	eax,[ebx+DebugPoint.thread]
	jne	debug_pass_breakpoint
	mov	eax,[debug_context.regEsp]
	cmp	eax,[ebx+DebugPoint.limit]
	jb	debug_pass_breakpoint
	; the traced thread has reached the place where the tracing should be continued
	mov	dl,DBP_STEP
	call	debug_clear_points
	mov	[debug_step_kind],DBGI_OTHER
	cmp	[debug_step_mode],0
	jne	debug_step_done
	jmp	debug_continue
    debug_pass_breakpoint:
	call	debug_pass
	jmp	debug_continue
    debug_user_breakpoint:
	mov	eax,DBGP_BREAKPOINT
	jmp	debug_pause
    debug_temporary_breakpoint:
	mov	eax,DBGP_STEP
	jmp	debug_pause
    debug_unknown_breakpoint:
	cmp	[debug_initial_breakpoint],0
	jne	debug_embedded_breakpoint
	mov	[debug_initial_breakpoint],1
	mov	eax,[debug_event.Exception.ExceptionAddress]
	sub	eax,[debug_image_base]
	cmp	eax,[debug_image_size]
	jae	debug_continue		; this one is signalled by the system when the process is initialized
    debug_embedded_breakpoint:
	call	debug_get_context
	mov	eax,DBGP_INT3
	jmp	debug_pause

    debug_single_step:
	mov	eax,[debug_thread_id]
	call	debug_end_pass
	jc	debug_foreign_step
	mov	eax,[debug_thread_id]
	cmp	eax,[debug_tracing]
	jne	debug_continue
	and	[debug_tracing],0
	cmp	[debug_step_mode],0
	je	debug_continue
	call	debug_get_context
	jmp	debug_step_done
    debug_foreign_step:
	mov	[debug_continue_status],DBG_EXCEPTION_NOT_HANDLED
	jmp	debug_continue

    debug_step_done:
	; the traced thread has executed an instruction, decide what should happen next
	test	[debug_request],DBGR_BREAK
	jnz	debug_step_interrupted
	test	[debug_request],DBGR_STOP
	jnz	debug_step_abandoned
	mov	eax,[debug_context.regEip]
	call	debug_find_line
	setnc	bl			; bl = 1 when the source of the reached instruction is known
	mov	al,[debug_step_kind]
	mov	ah,byte [debug_step_mode]
	cmp	ah,DBGC_INSN
	je	debug_step_completed
	cmp	al,DBGI_CALL
	jne	debug_step_not_call
	cmp	ah,DBGC_INTO
	jne	debug_step_skip_procedure
	test	bl,bl
	jnz	debug_step_not_call
    debug_step_skip_procedure:
	; let the procedure run freely and resume tracing when it returns
	call	debug_run_to_return
	jc	debug_step_abandoned
	jmp	debug_continue
    debug_step_not_call:
	cmp	ah,DBGC_OUT
	je	debug_step_out
	test	bl,bl
	jz	debug_step_outside
	mov	eax,[esi+DebugLine.path]
	cmp	eax,[debug_step_path]
	jne	debug_step_completed
	mov	eax,[esi+DebugLine.number]
	cmp	eax,[debug_step_line]
	jne	debug_step_completed
    debug_step_again:
	call	debug_trace
	jmp	debug_continue
    debug_step_out:
	cmp	al,DBGI_RETURN
	jne	debug_step_out_continued
	test	bl,bl
	jnz	debug_step_completed
	jmp	debug_step_abandoned
    debug_step_out_continued:
	test	bl,bl
	jnz	debug_step_again
    debug_step_outside:
	; execution has left the code with known source
	cmp	[debug_step_kind],DBGI_JUMP
	je	debug_step_skip_procedure
    debug_step_abandoned:
	and	[debug_step_mode],0
	jmp	debug_continue
    debug_step_completed:
	mov	eax,DBGP_STEP
	jmp	debug_pause
    debug_step_interrupted:
	lock and [debug_request],not DBGR_BREAK
	mov	eax,DBGP_BREAK
	jmp	debug_pause

    debug_pause:
	; in: eax = DBGP_# reason
	mov	[debug_pause_reason],eax
	and	[debug_step_mode],0
	mov	dl,DBP_TEMPORARY or DBP_STEP
	call	debug_clear_points
	call	debug_find_frame
	mov	[debug_state],DBGS_PAUSED
	invoke	PostMessage,[hwnd_main],FM_DEBUG,DBGN_PAUSED,[debug_pause_reason]
    debug_wait_for_command:
	invoke	WaitForSingleObject,[debug_command_event],-1
	xor	eax,eax
	xchg	eax,[debug_command]
	cmp	eax,DBGC_SYNC
	je	debug_command_sync
	cmp	eax,DBGC_STOP
	je	debug_command_stop
	cmp	eax,DBGC_GO
	je	debug_command_go
	cmp	eax,DBGC_RUNTO
	je	debug_command_run_to
	cmp	eax,DBGC_INTO
	je	debug_command_step
	cmp	eax,DBGC_OVER
	je	debug_command_step
	cmp	eax,DBGC_OUT
	je	debug_command_step
	jmp	debug_wait_for_command
    debug_command_sync:
	call	debug_update_points
	jmp	debug_wait_for_command
    debug_command_stop:
	invoke	TerminateProcess,[debug_pinfo.hProcess],0
	jmp	debug_resume
    debug_command_run_to:
	call	debug_set_temporary_points
    debug_command_go:
	call	debug_update_points
	cmp	[debug_pause_reason],DBGP_EXCEPTION
	je	debug_resume
	call	debug_get_context
	call	debug_pass
	jmp	debug_resume
    debug_command_step:
	mov	[debug_step_mode],eax
	call	debug_update_points
	cmp	[debug_pause_reason],DBGP_EXCEPTION
	je	debug_step_cancelled
	call	debug_get_context
	mov	eax,[debug_context.regEip]
	call	debug_find_line
	jc	debug_step_from_outside
	mov	eax,[esi+DebugLine.path]
	mov	[debug_step_path],eax
	mov	eax,[esi+DebugLine.number]
	mov	[debug_step_line],eax
	call	debug_trace
	jmp	debug_resume
    debug_step_from_outside:
	; the source of the current instruction is not known, try to get back to the known code
	xor	eax,eax
	mov	[debug_step_path],eax
	mov	[debug_step_line],eax
	mov	eax,[debug_frame_return]
	test	eax,eax
	jz	debug_step_blind
	mov	dl,DBP_STEP
	call	debug_set_point
	jc	debug_step_blind
	mov	eax,[debug_thread_id]
	mov	[ebx+DebugPoint.thread],eax
	mov	eax,[debug_frame_slot]
	add	eax,4
	mov	[ebx+DebugPoint.limit],eax
	mov	[debug_step_mode],DBGC_OVER
	call	debug_pass
	jmp	debug_resume
    debug_step_blind:
	cmp	[debug_step_mode],DBGC_OUT
	je	debug_step_trace
	mov	[debug_step_mode],DBGC_INSN
    debug_step_trace:
	call	debug_trace
	jmp	debug_resume
    debug_step_cancelled:
	and	[debug_step_mode],0
    debug_resume:
	cmp	[debug_suspended],0
	je	debug_continue
	mov	[debug_suspended],0
	call	debug_resume_threads
	jmp	debug_loop

debug_get_context:
; preserves: ebx, esi, edi
	mov	[debug_context.ContextFlags],CONTEXT_FULL
	invoke	GetThreadContext,[debug_thread],debug_context
	retn

debug_set_context:
; preserves: ebx, esi, edi
	mov	[debug_context.ContextFlags],CONTEXT_CONTROL
	invoke	SetThreadContext,[debug_thread],debug_context
	mov	[debug_context.ContextFlags],CONTEXT_FULL
	retn

debug_add_thread:
; in: eax = identifier of thread, edx = handle of thread
; preserves: ebx, esi, edi
	mov	ecx,[debug_threads_count]
	cmp	ecx,MAX_DEBUG_THREADS
	jae	.done
	mov	[debug_threads+ecx*8],eax
	mov	[debug_threads+ecx*8+4],edx
	inc	[debug_threads_count]
      .done:
	retn

debug_find_thread:
; in: eax = identifier of thread
; out: eax = handle of thread, zero when not found
; preserves: ebx, esi, edi
	mov	edx,debug_threads
	mov	ecx,[debug_threads_count]
	jecxz	.not_found
      .check:
	cmp	eax,[edx]
	je	.found
	add	edx,8
	loop	.check
      .not_found:
	xor	eax,eax
	retn
      .found:
	mov	eax,[edx+4]
	retn

debug_remove_thread:
; in: eax = identifier of thread
; preserves: ebx
	push	eax
	call	debug_end_pass
	pop	eax
	cmp	eax,[debug_tracing]
	jne	.tracing_ok
	and	[debug_tracing],0
	and	[debug_step_mode],0
      .tracing_ok:
	mov	edi,debug_threads
	mov	ecx,[debug_threads_count]
	jecxz	.done
      .check:
	cmp	eax,[edi]
	je	.found
	add	edi,8
	loop	.check
      .done:
	retn
      .found:
	dec	[debug_threads_count]
	dec	ecx
	shl	ecx,1
	lea	esi,[edi+8]
	rep	movsd
	retn

debug_suspend_threads:
; preserves: edi
	push	ebx esi
	mov	esi,debug_threads
	mov	ebx,[debug_threads_count]
      .suspend:
	test	ebx,ebx
	jz	.done
	invoke	SuspendThread,dword [esi+4]
	add	esi,8
	dec	ebx
	jmp	.suspend
      .done:
	pop	esi ebx
	retn

debug_resume_threads:
; preserves: edi
	push	ebx esi
	mov	esi,debug_threads
	mov	ebx,[debug_threads_count]
      .resume:
	test	ebx,ebx
	jz	.done
	invoke	ResumeThread,dword [esi+4]
	add	esi,8
	dec	ebx
	jmp	.resume
      .done:
	pop	esi ebx
	retn

debug_read_memory:
; in: esi = address in the memory of the debugged program, edi - buffer, ecx = number of bytes
; out: cf set when the memory could not be read
; preserves: ebx, ecx, esi, edi
; note: the breakpoints placed by the debugger are not visible in the retrieved data
	push	ecx
	invoke	ReadProcessMemory,[debug_pinfo.hProcess],esi,edi,ecx,NULL
	pop	ecx
	test	eax,eax
	jz	.failed
	push	ebx
	mov	ebx,debug_points
	mov	edx,[debug_points_limit]
      .check_point:
	test	edx,edx
	jz	.done
	mov	eax,[ebx+DebugPoint.address]
	test	eax,eax
	jz	.next_point
	cmp	[ebx+DebugPoint.lifted],0
	jne	.next_point
	sub	eax,esi
	jc	.next_point
	cmp	eax,ecx
	jae	.next_point
	push	edx
	mov	dl,[ebx+DebugPoint.original]
	mov	[edi+eax],dl
	pop	edx
      .next_point:
	add	ebx,sizeof.DebugPoint
	dec	edx
	jmp	.check_point
      .done:
	pop	ebx
	clc
	retn
      .failed:
	stc
	retn

debug_write_byte:
; in: eax = address in the memory of the debugged program, dl = value
; out: eax = zero when the memory could not be modified
; preserves: ebx, esi, edi
	mov	[debug_byte],dl
	push	eax
	invoke	WriteProcessMemory,[debug_pinfo.hProcess],eax,debug_byte,1,NULL
	pop	edx
	test	eax,eax
	jz	.done
	invoke	FlushInstructionCache,[debug_pinfo.hProcess],edx,1
	mov	eax,1
      .done:
	retn

debug_find_point:
; in: eax = address
; out:
;  cf set when there is no breakpoint at this address
;  when cf = 0:
;   ebx - DebugPoint
; preserves: eax, edx, esi, edi
	test	eax,eax
	jz	.not_found
	mov	ebx,debug_points
	mov	ecx,[debug_points_limit]
	jecxz	.not_found
      .check:
	cmp	eax,[ebx+DebugPoint.address]
	je	.found
	add	ebx,sizeof.DebugPoint
	loop	.check
      .not_found:
	stc
	retn
      .found:
	clc
	retn

debug_set_point:
; in: eax = address, dl = DBP_# flags
; out:
;  cf set when the breakpoint could not be placed
;  when cf = 0:
;   ebx - DebugPoint
; preserves: esi, edi
	call	debug_find_point
	jnc	.existing
	mov	ebx,debug_points
	xor	ecx,ecx
      .find_unused:
	cmp	ecx,[debug_points_limit]
	je	.extend
	cmp	[ebx+DebugPoint.address],0
	je	.unused_found
	add	ebx,sizeof.DebugPoint
	inc	ecx
	jmp	.find_unused
      .extend:
	cmp	ecx,MAX_DEBUG_POINTS
	jae	.failed
	inc	[debug_points_limit]
	and	[ebx+DebugPoint.address],0
      .unused_found:
	push	eax edx
	lea	edx,[ebx+DebugPoint.original]
	invoke	ReadProcessMemory,[debug_pinfo.hProcess],eax,edx,1,NULL
	test	eax,eax
	jz	.inaccessible
	mov	eax,[esp+4]
	mov	dl,0CCh
	call	debug_write_byte
	test	eax,eax
	jz	.inaccessible
	pop	edx eax
	mov	[ebx+DebugPoint.address],eax
	mov	[ebx+DebugPoint.flags],dl
	mov	[ebx+DebugPoint.lifted],0
	clc
	retn
      .inaccessible:
	pop	edx eax
      .failed:
	stc
	retn
      .existing:
	or	[ebx+DebugPoint.flags],dl
	clc
	retn

debug_remove_point:
; in: ebx - DebugPoint that has no flags left
; preserves: ebx, esi, edi
	cmp	[ebx+DebugPoint.lifted],0
	jne	.done			; the record is going to be released when the thread passing over it is done
	mov	eax,[ebx+DebugPoint.address]
	mov	dl,[ebx+DebugPoint.original]
	call	debug_write_byte
	and	[ebx+DebugPoint.address],0
      .done:
	retn

debug_clear_points:
; in: dl = DBP_# flags that should be removed from all the breakpoints
; preserves: esi, edi
	mov	ebx,debug_points
	mov	ecx,[debug_points_limit]
	jecxz	.done
	not	dl
      .check:
	cmp	[ebx+DebugPoint.address],0
	je	.next
	cmp	[ebx+DebugPoint.flags],0
	je	.next
	and	[ebx+DebugPoint.flags],dl
	jnz	.next
	push	ecx edx
	call	debug_remove_point
	pop	edx ecx
      .next:
	add	ebx,sizeof.DebugPoint
	loop	.check
      .done:
	retn

debug_update_points:
; note: makes the breakpoints in the memory of the program correspond to the ones requested by user
	invoke	EnterCriticalSection,debug_lock
	mov	ebx,debug_points
	mov	ecx,[debug_points_limit]
	jecxz	.unwanted_removed
      .check:
	cmp	[ebx+DebugPoint.address],0
	je	.next
	test	[ebx+DebugPoint.flags],DBP_USER
	jz	.next
	push	ecx
	mov	eax,[ebx+DebugPoint.address]
	sub	eax,[debug_image_base]
	mov	edi,debug_wanted
	mov	ecx,[debug_wanted_count]
	test	ecx,ecx
	jz	.unwanted
	repne	scasd
	je	.wanted
      .unwanted:
	and	[ebx+DebugPoint.flags],not DBP_USER
	jnz	.wanted
	call	debug_remove_point
      .wanted:
	pop	ecx
      .next:
	add	ebx,sizeof.DebugPoint
	loop	.check
      .unwanted_removed:
	mov	esi,debug_wanted
	mov	edi,[debug_wanted_count]
      .set:
	test	edi,edi
	jz	.done
	lodsd
	add	eax,[debug_image_base]
	mov	dl,DBP_USER
	call	debug_set_point
	dec	edi
	jmp	.set
      .done:
	invoke	LeaveCriticalSection,debug_lock
	retn

debug_set_temporary_points:
; note: places the temporary breakpoints requested by user
	invoke	EnterCriticalSection,debug_lock
	mov	esi,debug_run_to
	mov	edi,[debug_run_to_count]
      .set:
	test	edi,edi
	jz	.done
	lodsd
	add	eax,[debug_image_base]
	mov	dl,DBP_TEMPORARY
	call	debug_set_point
	dec	edi
	jmp	.set
      .done:
	and	[debug_run_to_count],0
	invoke	LeaveCriticalSection,debug_lock
	retn

debug_begin_pass:
; in: eax = identifier of thread that is going to execute a single instruction, edx - lifted DebugPoint or null
; preserves: ebx, esi, edi
	push	ebx
	mov	ebx,debug_passes
	mov	ecx,MAX_DEBUG_PASSES
      .find_unused:
	cmp	[ebx+DebugPass.thread],0
	je	.store
	add	ebx,sizeof.DebugPass
	loop	.find_unused
	mov	ebx,debug_passes
      .store:
	mov	[ebx+DebugPass.thread],eax
	mov	[ebx+DebugPass.point],edx
	pop	ebx
	retn

debug_end_pass:
; in: eax = identifier of thread
; out: cf set when this thread was not executing a single instruction on behalf of the debugger
; preserves: ebx, esi, edi
	push	ebx
	mov	ebx,debug_passes
	mov	ecx,MAX_DEBUG_PASSES
      .check:
	cmp	eax,[ebx+DebugPass.thread]
	je	.found
	add	ebx,sizeof.DebugPass
	loop	.check
	pop	ebx
	stc
	retn
      .found:
	and	[ebx+DebugPass.thread],0
	mov	ebx,[ebx+DebugPass.point]
	test	ebx,ebx
	jz	.done
	dec	[ebx+DebugPoint.lifted]
	jnz	.done
	cmp	[ebx+DebugPoint.flags],0
	je	.release
	mov	eax,[ebx+DebugPoint.address]
	mov	dl,0CCh
	call	debug_write_byte
	jmp	.done
      .release:
	and	[ebx+DebugPoint.address],0
      .done:
	pop	ebx
	clc
	retn

debug_lift:
; out: ebx - DebugPoint that was at the current instruction and has been lifted, null when there was none
; preserves: esi, edi
	mov	eax,[debug_context.regEip]
	call	debug_find_point
	jc	.none
	cmp	[ebx+DebugPoint.lifted],0
	jne	.lifted
	mov	eax,[ebx+DebugPoint.address]
	mov	dl,[ebx+DebugPoint.original]
	call	debug_write_byte
      .lifted:
	inc	[ebx+DebugPoint.lifted]
	retn
      .none:
	xor	ebx,ebx
	retn

debug_pass:
; note: when the current thread is stopped at a breakpoint, this allows it to execute the original instruction
	call	debug_lift
	test	ebx,ebx
	jz	.done
	mov	eax,[debug_thread_id]
	mov	edx,ebx
	call	debug_begin_pass
	or	[debug_context.regFlag],EFLAGS_TF
	call	debug_set_context
      .done:
	retn

debug_trace:
; note: makes the current thread stop again after it executes a single instruction
	mov	eax,[debug_context.regEip]
	call	debug_classify
	mov	[debug_step_kind],al
	cmp	al,DBGI_REPEAT
	jne	.single_step
	; a repeated instruction would be reported after every iteration, it is better to wait until it is finished
	mov	[debug_step_kind],DBGI_OTHER
	push	ecx
	mov	dl,DBP_STEP
	call	debug_clear_points
	pop	ecx
	mov	eax,[debug_context.regEip]
	add	eax,ecx
	mov	dl,DBP_STEP
	call	debug_set_point
	jc	.single_step
	mov	eax,[debug_thread_id]
	mov	[ebx+DebugPoint.thread],eax
	mov	eax,[debug_context.regEsp]
	mov	[ebx+DebugPoint.limit],eax
	jmp	debug_pass
      .single_step:
	mov	eax,[debug_thread_id]
	mov	[debug_tracing],eax
	call	debug_lift
	mov	eax,[debug_thread_id]
	mov	edx,ebx
	call	debug_begin_pass
	or	[debug_context.regFlag],EFLAGS_TF
	jmp	debug_set_context

debug_run_to_return:
; out: cf set when it was not possible to place a breakpoint at the address stored at the top of the stack
	mov	dl,DBP_STEP
	call	debug_clear_points
	mov	esi,[debug_context.regEsp]
	mov	edi,debug_value
	mov	ecx,4
	call	debug_read_memory
	jc	.failed
	mov	eax,[debug_value]
	mov	dl,DBP_STEP
	call	debug_set_point
	jc	.failed
	mov	eax,[debug_thread_id]
	mov	[ebx+DebugPoint.thread],eax
	mov	eax,[debug_context.regEsp]
	add	eax,4
	mov	[ebx+DebugPoint.limit],eax
	clc
      .failed:
	retn

debug_classify:
; in: eax = address of instruction
; out: al = DBGI_# class of instruction, ecx = length of instruction when al = DBGI_REPEAT
	mov	esi,eax
	mov	edi,debug_code
	xor	eax,eax
	mov	[edi],eax
	mov	[edi+4],eax
	mov	[edi+8],eax
	mov	[edi+12],eax
	mov	ecx,16
      .read:
	call	debug_read_memory
	jnc	.decode
	shr	ecx,1
	jnz	.read
	jmp	.other
      .decode:
	mov	esi,debug_code
	xor	ecx,ecx
	xor	dl,dl
      .prefix:
	lodsb
	cmp	al,0F3h
	je	.repeat_prefix
	cmp	al,0F2h
	je	.repeat_prefix
	cmp	al,0F0h
	je	.next_prefix
	cmp	al,66h
	je	.next_prefix
	cmp	al,67h
	je	.next_prefix
	cmp	al,26h
	je	.next_prefix
	cmp	al,2Eh
	je	.next_prefix
	cmp	al,36h
	je	.next_prefix
	cmp	al,3Eh
	je	.next_prefix
	cmp	al,64h
	je	.next_prefix
	cmp	al,65h
	jne	.opcode
      .next_prefix:
	inc	ecx
	cmp	ecx,14
	jb	.prefix
	jmp	.other
      .repeat_prefix:
	mov	dl,1
	jmp	.next_prefix
      .opcode:
	cmp	al,0E8h
	je	.call
	cmp	al,9Ah
	je	.call
	cmp	al,0E9h
	je	.jump
	cmp	al,0EAh
	je	.jump
	cmp	al,0EBh
	je	.jump
	cmp	al,0C3h
	je	.return
	cmp	al,0C2h
	je	.return
	cmp	al,0CBh
	je	.return
	cmp	al,0CAh
	je	.return
	cmp	al,0CFh
	je	.return
	cmp	al,0FFh
	jne	.string
	mov	al,[esi]
	shr	al,3
	and	al,7
	cmp	al,2
	je	.call
	cmp	al,3
	je	.call
	cmp	al,4
	je	.jump
	cmp	al,5
	je	.jump
      .other:
	mov	al,DBGI_OTHER
	retn
      .string:
	test	dl,dl
	jz	.other
	cmp	al,6Ch
	jb	.other
	cmp	al,6Fh
	jbe	.repeated
	cmp	al,0A4h
	jb	.other
	cmp	al,0A7h
	jbe	.repeated
	cmp	al,0AAh
	jb	.other
	cmp	al,0AFh
	ja	.other
      .repeated:
	inc	ecx
	mov	al,DBGI_REPEAT
	retn
      .call:
	mov	al,DBGI_CALL
	retn
      .jump:
	mov	al,DBGI_JUMP
	retn
      .return:
	mov	al,DBGI_RETURN
	retn

debug_find_frame:
; out:
;  [debug_frame_return] = address in the known code to which the current thread is expected to return, zero when not found
;  [debug_frame_slot] = address of the stack entry that holds the above value
; note:
;  when the thread is stopped in a code with no source available (like a system library),
;  this finds the place in the program from which that code has been called
	and	[debug_frame_return],0
	mov	eax,[debug_context.regEip]
	call	debug_find_line
	jnc	.done
	mov	ebx,[debug_context.regEsp]
	and	ebx,not 3
	mov	[debug_frame_range],4000h
      .read_stack:
	mov	ecx,ebx
	neg	ecx
	and	ecx,0FFh
	jnz	.read_portion
	mov	ecx,100h
      .read_portion:
	mov	esi,ebx
	mov	edi,debug_frame_buffer
	call	debug_read_memory
	jc	.done
	xor	edx,edx
      .check_entry:
	mov	eax,dword [debug_frame_buffer+edx]
	push	ebx ecx edx
	call	debug_check_return_address
	pop	edx ecx ebx
	jnc	.found
	add	edx,4
	cmp	edx,ecx
	jb	.check_entry
	add	ebx,ecx
	sub	[debug_frame_range],ecx
	ja	.read_stack
      .done:
	retn
      .found:
	mov	eax,dword [debug_frame_buffer+edx]
	mov	[debug_frame_return],eax
	add	ebx,edx
	mov	[debug_frame_slot],ebx
	retn

debug_check_return_address:
; in: eax = value
; out: cf clear when this is an address within the known code that directly follows a call instruction
	push	eax
	call	debug_find_line
	pop	eax
	jc	.invalid
	lea	esi,[eax-8]
	mov	edi,debug_code
	mov	ecx,8
	call	debug_read_memory
	jc	.invalid
	cmp	byte [debug_code+3],0E8h
	je	.valid
	mov	esi,debug_code+1
	call	.check_indirect
	je	.valid
	mov	esi,debug_code+2
	call	.check_indirect
	je	.valid
	mov	esi,debug_code+4
	call	.check_indirect
	je	.valid
	mov	esi,debug_code+5
	call	.check_indirect
	je	.valid
	mov	esi,debug_code+6
	call	.check_indirect
	je	.valid
      .invalid:
	stc
	retn
      .valid:
	clc
	retn
      .check_indirect:
	cmp	byte [esi],0FFh
	jne	.checked
	mov	al,[esi+1]
	and	al,38h
	cmp	al,10h
      .checked:
	retn

; ----------------------------------------------------------------------------
;  interface
; ----------------------------------------------------------------------------

proc DebugLineMarks uses ebx esi, hwnd,line
; note: this is called by the editor to find out how a line of text should be marked
	xor	eax,eax
	mov	edx,[hwnd]
	mov	ecx,[line]
	cmp	edx,[debug_execution_hwnd]
	jne	.execution_ok
	cmp	ecx,[debug_execution_line]
	jne	.execution_ok
	or	eax,DBGM_EXECUTION
      .execution_ok:
	cmp	edx,[debug_frame_hwnd]
	jne	.frame_ok
	cmp	ecx,[debug_frame_line]
	jne	.frame_ok
	or	eax,DBGM_FRAME
      .frame_ok:
	mov	ebx,breakpoints
	mov	esi,[breakpoints_count]
      .check:
	test	esi,esi
	jz	.done
	cmp	edx,[ebx+Breakpoint.hwnd]
	jne	.next
	cmp	ecx,[ebx+Breakpoint.line]
	jne	.next
	or	eax,DBGM_BREAKPOINT
	jmp	.done
      .next:
	add	ebx,sizeof.Breakpoint
	dec	esi
	jmp	.check
      .done:
	ret
endp

proc DebugToggleBreakpoint uses ebx esi
; note: sets or removes a breakpoint at the line containing the caret
	invoke	SendMessage,[hwnd_fedit],FEM_GETPOS,fepos,0
	mov	edx,[hwnd_fedit]
	mov	ecx,[fepos.caretLine]
	mov	ebx,breakpoints
	mov	esi,[breakpoints_count]
      .find:
	test	esi,esi
	jz	.set
	cmp	edx,[ebx+Breakpoint.hwnd]
	jne	.next
	cmp	ecx,[ebx+Breakpoint.line]
	je	.remove
      .next:
	add	ebx,sizeof.Breakpoint
	dec	esi
	jmp	.find
      .set:
	cmp	[breakpoints_count],MAX_BREAKPOINTS
	jae	.done
	mov	[ebx+Breakpoint.hwnd],edx
	mov	[ebx+Breakpoint.line],ecx
	inc	[breakpoints_count]
	jmp	.changed
      .remove:
	call	debug_delete_breakpoint
      .changed:
	invoke	SendMessage,[hwnd_fedit],FEM_UPDATELINEMARKS,0,0
	stdcall DebugSynchronizeBreakpoints
      .done:
	ret
endp

debug_delete_breakpoint:
; in: ebx - Breakpoint
; preserves: ebx, ecx, edx, esi, edi
	push	ecx
	dec	[breakpoints_count]
	mov	eax,[breakpoints_count]
	lea	eax,[breakpoints+eax*sizeof.Breakpoint]
	mov	ecx,[eax+Breakpoint.hwnd]
	mov	[ebx+Breakpoint.hwnd],ecx
	mov	ecx,[eax+Breakpoint.line]
	mov	[ebx+Breakpoint.line],ecx
	pop	ecx
	retn

proc DebugClearBreakpoints uses ebx
; note: removes all the breakpoints
	and	[breakpoints_count],0
	invoke	SendMessage,[hwnd_fedit],FEM_UPDATELINEMARKS,0,0
	stdcall DebugSynchronizeBreakpoints
	ret
endp

proc DebugForgetEditor uses ebx esi, hwnd
; note: called when an editor window is closed
	mov	edx,[hwnd]
	mov	ebx,breakpoints
	mov	esi,[breakpoints_count]
      .check:
	test	esi,esi
	jz	.breakpoints_ok
	dec	esi
	cmp	edx,[ebx+Breakpoint.hwnd]
	jne	.next
	call	debug_delete_breakpoint
	jmp	.check
      .next:
	add	ebx,sizeof.Breakpoint
	jmp	.check
      .breakpoints_ok:
	cmp	edx,[debug_execution_hwnd]
	jne	.execution_ok
	and	[debug_execution_hwnd],0
      .execution_ok:
	cmp	edx,[debug_frame_hwnd]
	jne	.frame_ok
	and	[debug_frame_hwnd],0
      .frame_ok:
	cmp	edx,[debug_tracked_hwnd]
	jne	.tracking_ok
	and	[debug_tracked_hwnd],0
      .tracking_ok:
	stdcall DebugSynchronizeBreakpoints
	ret
endp

proc DebugTrackEditor uses ebx, hwnd
; note: called when an editor window is selected, to keep track of the changes in its text
	mov	ebx,[hwnd]
	mov	[debug_tracked_hwnd],ebx
	invoke	SendMessage,ebx,FEM_GETLINECOUNT,0,0
	mov	[debug_tracked_lines],eax
	ret
endp

proc DebugTextChanged uses ebx esi edi, hwnd
; note:
;  called when the text in an editor window is altered, if the number of lines has changed,
;  the breakpoints that follow the place of modification are moved accordingly
	mov	ebx,[hwnd]
	invoke	SendMessage,ebx,FEM_GETLINECOUNT,0,0
	cmp	ebx,[debug_tracked_hwnd]
	je	.tracked
	mov	[debug_tracked_hwnd],ebx
	mov	[debug_tracked_lines],eax
	jmp	.done
      .tracked:
	mov	edi,eax
	xchg	eax,[debug_tracked_lines]
	sub	edi,eax 		; edi = number of lines added
	jz	.done
	invoke	SendMessage,ebx,FEM_GETPOS,debug_fepos,0
	mov	edx,[debug_fepos.caretLine]
	mov	eax,ebx
	mov	ebx,breakpoints
	mov	esi,[breakpoints_count]
	test	edi,edi
	js	.lines_removed
	sub	edx,edi 		; the lines that follow this one have been moved
      .check_added:
	test	esi,esi
	jz	.done
	cmp	eax,[ebx+Breakpoint.hwnd]
	jne	.next_added
	cmp	[ebx+Breakpoint.line],edx
	jbe	.next_added
	add	[ebx+Breakpoint.line],edi
      .next_added:
	add	ebx,sizeof.Breakpoint
	dec	esi
	jmp	.check_added
      .lines_removed:
	mov	ecx,edx
	sub	ecx,edi 		; the lines up to this one have been merged into the one containing the caret
      .check_removed:
	test	esi,esi
	jz	.done
	cmp	eax,[ebx+Breakpoint.hwnd]
	jne	.next_removed
	cmp	[ebx+Breakpoint.line],edx
	jbe	.next_removed
	cmp	[ebx+Breakpoint.line],ecx
	ja	.move_up
	mov	[ebx+Breakpoint.line],edx
	jmp	.next_removed
      .move_up:
	add	[ebx+Breakpoint.line],edi
      .next_removed:
	add	ebx,sizeof.Breakpoint
	dec	esi
	jmp	.check_removed
      .done:
	ret
endp

proc DebugGetEditorPath uses ebx, hwnd
; out: eax - path of the file edited in the given window, null when there is none
	xor	ebx,ebx
      .check:
	mov	[debug_ei.header.mask],TCIF_PARAM
	invoke	SendMessage,[hwnd_tabctrl],TCM_GETITEM,ebx,debug_ei
	test	eax,eax
	jz	.done
	mov	eax,[debug_ei.hwnd]
	cmp	eax,[hwnd]
	je	.found
	inc	ebx
	jmp	.check
      .found:
	mov	eax,[debug_ei.pszpath]
      .done:
	ret
endp

proc DebugFindFile uses ebx, path
; out: eax - the same path as kept in the debug information, null when the file was not a part of the assembled source
	invoke	GetFullPathName,[path],1000h,debug_interface_path,debug_interface_part
	xor	ebx,ebx
      .check:
	cmp	ebx,[debug_files_count]
	jae	.not_found
	invoke	lstrcmpi,[debug_files+ebx*4],debug_interface_path
	test	eax,eax
	jz	.found
	inc	ebx
	jmp	.check
      .found:
	mov	eax,[debug_files+ebx*4]
	ret
      .not_found:
	xor	eax,eax
	ret
endp

proc DebugLocateLine uses ebx esi edi, path,line,buffer,capacity
; in:
;  path - path of file as kept in the debug information
;  line = number of line
;  buffer - where the addresses (relative to the base of image) should be stored
;  capacity = maximum number of addresses to store
; out:
;  eax = number of stored addresses
; note:
;  when the given line has not generated any code, the first one that follows it and has done so is used instead;
;  there may be more than one address, because the same line of source can be assembled multiple times
	or	ebx,-1
	mov	esi,[debug_lines]
	mov	edi,[debug_lines_count]
      .find:
	test	edi,edi
	jz	.collect
	mov	eax,[esi+DebugLine.path]
	cmp	eax,[path]
	jne	.find_next
	mov	eax,[esi+DebugLine.number]
	cmp	eax,[line]
	jb	.find_next
	cmp	eax,ebx
	jae	.find_next
	call	debug_line_address
	jc	.find_next
	mov	ebx,[esi+DebugLine.number]
      .find_next:
	add	esi,sizeof.DebugLine
	dec	edi
	jmp	.find
      .collect:
	mov	esi,[debug_lines]
	mov	edi,[debug_lines_count]
	mov	ecx,[buffer]
      .check:
	test	edi,edi
	jz	.done
	cmp	[capacity],0
	je	.done
	mov	eax,[esi+DebugLine.path]
	cmp	eax,[path]
	jne	.next
	cmp	ebx,[esi+DebugLine.number]
	jne	.next
	push	ecx
	call	debug_line_address
	pop	ecx
	jc	.next
	mov	[ecx],eax
	add	ecx,4
	dec	[capacity]
      .next:
	add	esi,sizeof.DebugLine
	dec	edi
	jmp	.check
      .done:
	mov	eax,ecx
	sub	eax,[buffer]
	shr	eax,2
	ret
endp

proc DebugCollectBreakpoints uses ebx esi edi
; note: prepares the list of addresses of the breakpoints for the debugger thread
	invoke	EnterCriticalSection,debug_lock
	and	[debug_wanted_count],0
	cmp	[debug_info_ready],0
	je	.done
	mov	ebx,breakpoints
	mov	esi,[breakpoints_count]
      .next:
	test	esi,esi
	jz	.done
	stdcall DebugGetEditorPath,[ebx+Breakpoint.hwnd]
	test	eax,eax
	jz	.skip
	stdcall DebugFindFile,eax
	test	eax,eax
	jz	.skip
	mov	edx,[debug_wanted_count]
	lea	edi,[debug_wanted+edx*4]
	mov	ecx,MAX_DEBUG_WANTED
	sub	ecx,edx
	stdcall DebugLocateLine,eax,[ebx+Breakpoint.line],edi,ecx
	add	[debug_wanted_count],eax
      .skip:
	add	ebx,sizeof.Breakpoint
	dec	esi
	jmp	.next
      .done:
	invoke	LeaveCriticalSection,debug_lock
	ret
endp

proc DebugSynchronizeBreakpoints
; note: when a program is being debugged, makes the debugger thread aware of the changes in breakpoints
	cmp	[debug_state],DBGS_NONE
	je	.done
	stdcall DebugCollectBreakpoints
	cmp	[debug_state],DBGS_PAUSED
	jne	.running
	mov	[debug_command],DBGC_SYNC
	invoke	SetEvent,[debug_command_event]
	jmp	.done
      .running:
	lock or [debug_request],DBGR_SYNC
      .done:
	ret
endp

proc DebugCollectCaretLine uses ebx
; out: eax = number of addresses stored in the list of temporary breakpoints
; note: prepares the list of addresses of the line containing the caret
	xor	ebx,ebx
	invoke	EnterCriticalSection,debug_lock
	and	[debug_run_to_count],0
	cmp	[debug_info_ready],0
	je	.done
	stdcall DebugGetEditorPath,[hwnd_fedit]
	test	eax,eax
	jz	.done
	stdcall DebugFindFile,eax
	test	eax,eax
	jz	.done
	mov	ebx,eax
	invoke	SendMessage,[hwnd_fedit],FEM_GETPOS,fepos,0
	stdcall DebugLocateLine,ebx,[fepos.caretLine],debug_run_to,MAX_DEBUG_RUN_TO
	mov	[debug_run_to_count],eax
	mov	ebx,eax
      .done:
	invoke	LeaveCriticalSection,debug_lock
	mov	eax,ebx
	ret
endp

proc DebugRun uses ebx esi edi, command
; in: command = DBGC_# command
; note: resumes the debugged program, or starts debugging when no program is being debugged
	mov	eax,[debug_state]
	cmp	eax,DBGS_RUNNING
	je	.done
	cmp	eax,DBGS_PAUSED
	je	.resume
	cmp	[hthread_debug],0
	jne	.done
	invoke	SendMessage,[hwnd_main],FM_COMPILE,0,FALSE
	or	eax,eax
	jnz	.done
	stdcall DebugLoadImage
	test	eax,eax
	jnz	.cannot_debug
	cmp	[debug_info_ready],0
	je	.no_information
	mov	[debug_break_at_entry],0
	and	[debug_run_to_count],0
	mov	eax,[command]
	cmp	eax,DBGC_INTO
	je	.break_at_entry
	cmp	eax,DBGC_OVER
	je	.break_at_entry
	cmp	eax,DBGC_RUNTO
	jne	.start
	stdcall DebugCollectCaretLine
	test	eax,eax
	jnz	.start
	invoke	MessageBox,[hwnd_main],_debug_no_code,_caption,MB_ICONINFORMATION+MB_OK
	jmp	.done
      .break_at_entry:
	mov	[debug_break_at_entry],1
      .start:
	stdcall DebugCollectBreakpoints
	xor	eax,eax
	mov	[debug_command],eax
	mov	[debug_request],eax
	mov	[debug_threads_count],eax
	mov	[debug_points_limit],eax
	mov	[debug_step_mode],eax
	mov	[debug_tracing],eax
	mov	[debug_suspended],al
	mov	[debug_initial_breakpoint],al
	mov	[debug_frame_return],eax
	mov	edi,debug_passes
	mov	ecx,MAX_DEBUG_PASSES*sizeof.DebugPass shr 2
	rep	stosd
	cmp	[debug_command_event],0
	jne	.event_ok
	invoke	CreateEvent,NULL,FALSE,FALSE,NULL
	mov	[debug_command_event],eax
      .event_ok:
	invoke	ResetEvent,[debug_command_event]
	stdcall DebugShowPanel,TRUE
	cinvoke wsprintf,debug_text,_debug_log_started,executable_path
	stdcall DebugLog,debug_text
	mov	[debug_state],DBGS_RUNNING
	invoke	CreateThread,NULL,10000h,debug_thread_proc,0,0,debug_interface_part
	mov	[hthread_debug],eax
	test	eax,eax
	jz	.failed
	stdcall DebugSetStatus,_debug_status_running
	jmp	.done
      .failed:
	mov	[debug_state],DBGS_NONE
	jmp	.done
      .no_information:
	mov	eax,_debug_no_information
      .cannot_debug:
	invoke	MessageBox,[hwnd_main],eax,_caption,MB_ICONERROR+MB_OK
	jmp	.done
      .resume:
	mov	eax,[command]
	cmp	eax,DBGC_RUNTO
	jne	.send
	stdcall DebugCollectCaretLine
	test	eax,eax
	jnz	.send
	invoke	MessageBox,[hwnd_main],_debug_no_code,_caption,MB_ICONINFORMATION+MB_OK
	jmp	.done
      .send:
	stdcall DebugCollectBreakpoints
	stdcall DebugClearMarks
	stdcall DebugSetStatus,_debug_status_running
	mov	[debug_state],DBGS_RUNNING
	mov	eax,[command]
	mov	[debug_command],eax
	invoke	SetEvent,[debug_command_event]
      .done:
	ret
endp

proc DebugBreak
; note: interrupts the execution of the debugged program
	cmp	[debug_state],DBGS_RUNNING
	jne	.done
	lock or [debug_request],DBGR_BREAK
      .done:
	ret
endp

proc DebugStop
; note: terminates the debugged program
	mov	eax,[debug_state]
	cmp	eax,DBGS_PAUSED
	je	.paused
	cmp	eax,DBGS_RUNNING
	jne	.done
	lock or [debug_request],DBGR_STOP
	jmp	.done
      .paused:
	stdcall DebugClearMarks
	mov	[debug_state],DBGS_RUNNING
	mov	[debug_command],DBGC_STOP
	invoke	SetEvent,[debug_command_event]
      .done:
	ret
endp

proc DebugShutdown
; note: ends the debugging session and waits until the debugger thread finishes
	cmp	[hthread_debug],0
	je	.done
	stdcall DebugStop
	invoke	WaitForSingleObject,[hthread_debug],5000
	cmp	eax,WAIT_TIMEOUT
	jne	.finished
	invoke	TerminateThread,[hthread_debug],0
	mov	[debug_state],DBGS_NONE
      .finished:
	stdcall DebugSessionEnded
      .done:
	ret
endp

proc DebugConfirmStop
; out: eax = non-zero when no program is being debugged (anymore)
; note: when a program is being debugged, asks whether it should be terminated
	cmp	[hthread_debug],0
	je	.stopped
	invoke	MessageBox,[hwnd_main],_debug_stop_question,_caption,MB_ICONQUESTION+MB_YESNO
	cmp	eax,IDYES
	jne	.cancelled
	stdcall DebugShutdown
      .stopped:
	mov	eax,1
	ret
      .cancelled:
	xor	eax,eax
	ret
endp

proc DebugSessionEnded
; note: releases the resources of the finished debugging session
	cmp	[hthread_debug],0
	je	.done
	invoke	CloseHandle,[hthread_debug]
	and	[hthread_debug],0
	stdcall DebugClearMarks
	stdcall DebugClearViews
      .done:
	ret
endp

proc DebugClearMarks uses ebx
; note: removes the marks of the stopped program from the editor windows
	xor	ebx,ebx
	xchg	ebx,[debug_execution_hwnd]
	test	ebx,ebx
	jz	.execution_ok
	invoke	SendMessage,ebx,FEM_UPDATELINEMARKS,0,0
      .execution_ok:
	xor	ebx,ebx
	xchg	ebx,[debug_frame_hwnd]
	test	ebx,ebx
	jz	.frame_ok
	invoke	SendMessage,ebx,FEM_UPDATELINEMARKS,0,0
      .frame_ok:
	ret
endp

proc DebugShowLine uses ebx esi edi, path,line
; out: eax = window of the editor showing the given line, zero when the file could not be displayed
; note: brings up the editor containing the given file (loading it if needed) and moves the caret to the given line
	xor	ebx,ebx
      .find_file:
	mov	[debug_ei.header.mask],TCIF_PARAM
	invoke	SendMessage,[hwnd_tabctrl],TCM_GETITEM,ebx,debug_ei
	or	eax,eax
	jz	.load_file
	cmp	[debug_ei.pszpath],0
	je	.next_file
	invoke	lstrcmpi,[debug_ei.pszpath],[path]
	or	eax,eax
	jz	.file_found
      .next_file:
	inc	ebx
	jmp	.find_file
      .load_file:
	mov	esi,[path]
	mov	edi,path_buffer
      .copy_path:
	lodsb
	stosb
	or	al,al
	jnz	.copy_path
	invoke	GetFileTitle,path_buffer,name_buffer,100h
	invoke	SendMessage,[hwnd_main],FM_OPEN,name_buffer,path_buffer
	cmp	eax,-1
	je	.failed
	jmp	.show
      .file_found:
	invoke	SendMessage,[hwnd_tabctrl],TCM_GETCURSEL,0,0
	cmp	eax,ebx
	je	.show
	invoke	SendMessage,[hwnd_tabctrl],TCM_SETCURSEL,ebx,0
	invoke	SendMessage,[hwnd_main],FM_SELECT,ebx,0
      .show:
	mov	[debug_fepos.selectionPosition],1
	mov	[debug_fepos.caretPosition],1
	; visit the neighbouring lines first, to have them visible too
	mov	eax,[line]
	sub	eax,3
	jg	.show_preceding
	mov	eax,1
      .show_preceding:
	call	.move_caret
	mov	eax,[line]
	add	eax,6
	call	.move_caret
	mov	eax,[line]
	call	.move_caret
	mov	eax,[hwnd_fedit]
	ret
      .move_caret:
	mov	[debug_fepos.selectionLine],eax
	mov	[debug_fepos.caretLine],eax
	invoke	SendMessage,[hwnd_fedit],FEM_SETPOS,debug_fepos,0
	retn
      .failed:
	xor	eax,eax
	ret
endp

proc DebugNotification uses ebx esi edi, code,param
; note: handles the notifications from the debugger thread
	mov	eax,[code]
	cmp	eax,DBGN_PAUSED
	je	.paused
	cmp	eax,DBGN_EXITED
	je	.exited
	cmp	eax,DBGN_FAILED
	je	.failed
	cmp	eax,DBGN_OUTPUT
	je	.output
	jmp	.done
      .output:
	mov	esi,[param]
	stdcall DebugLog,esi
	invoke	HeapFree,[hheap],0,esi
	jmp	.done
      .failed:
	invoke	WaitForSingleObject,[hthread_debug],1000
	stdcall DebugSessionEnded
	stdcall DebugSetStatus,_null
	invoke	MessageBox,[hwnd_main],_debug_cannot_start,_caption,MB_ICONERROR+MB_OK
	jmp	.done
      .exited:
	cmp	[hthread_debug],0
	je	.done
	invoke	WaitForSingleObject,[hthread_debug],1000
	cmp	eax,WAIT_TIMEOUT
	je	.done			; this notification must have come from an earlier session
	stdcall DebugSessionEnded
	cinvoke wsprintf,debug_text,_debug_status_exited,[param],[param]
	stdcall DebugSetStatus,debug_text
	stdcall DebugLog,debug_text
	jmp	.done
      .paused:
	cmp	[debug_state],DBGS_PAUSED
	jne	.done
	stdcall DebugClearMarks
	; show where the program has stopped
	xor	edi,edi
	mov	eax,[debug_context.regEip]
	call	debug_find_line
	jc	.no_source
	mov	edi,esi
	stdcall DebugShowLine,[esi+DebugLine.path],[esi+DebugLine.number]
	test	eax,eax
	jz	.location_shown
	mov	[debug_execution_hwnd],eax
	mov	eax,[edi+DebugLine.number]
	mov	[debug_execution_line],eax
	invoke	SendMessage,[debug_execution_hwnd],FEM_UPDATELINEMARKS,0,0
	jmp	.location_shown
      .no_source:
	; the source of the current instruction is not known, show the call that led to it
	mov	eax,[debug_frame_return]
	test	eax,eax
	jz	.location_shown
	dec	eax
	call	debug_find_line
	jc	.location_shown
	mov	ebx,esi
	stdcall DebugShowLine,[esi+DebugLine.path],[esi+DebugLine.number]
	test	eax,eax
	jz	.location_shown
	mov	[debug_frame_hwnd],eax
	mov	eax,[ebx+DebugLine.number]
	mov	[debug_frame_line],eax
	invoke	SendMessage,[debug_frame_hwnd],FEM_UPDATELINEMARKS,0,0
      .location_shown:
	; describe the reason
	mov	eax,[param]
	mov	esi,_debug_status_breakpoint
	cmp	eax,DBGP_BREAKPOINT
	je	.reason_ok
	mov	esi,_debug_status_break
	cmp	eax,DBGP_BREAK
	je	.reason_ok
	mov	esi,_debug_status_int3
	cmp	eax,DBGP_INT3
	je	.reason_ok
	mov	esi,_debug_status_paused
	cmp	eax,DBGP_EXCEPTION
	jne	.reason_ok
	stdcall DebugDescribeException
	stdcall DebugLog,debug_text
	mov	esi,debug_text
      .reason_ok:
	mov	[debug_arguments],esi
	mov	eax,[debug_context.regEip]
	mov	[debug_arguments+4],eax
	mov	esi,_debug_status_address
	test	edi,edi
	jz	.status_ready
	invoke	GetFileTitle,[edi+DebugLine.path],name_buffer,100h
	mov	[debug_arguments+4],name_buffer
	mov	eax,[edi+DebugLine.number]
	mov	[debug_arguments+8],eax
	mov	esi,_debug_status_line
      .status_ready:
	invoke	wvsprintf,debug_status,esi,debug_arguments
	stdcall DebugSetStatus,debug_status
	stdcall DebugUpdateViews
	invoke	IsIconic,[hwnd_main]
	test	eax,eax
	jz	.window_ok
	invoke	ShowWindow,[hwnd_main],SW_RESTORE
      .window_ok:
	invoke	SetForegroundWindow,[hwnd_main]
      .done:
	ret
endp

proc DebugDescribeException uses ebx esi
; out: debug_text - text describing the exception that has stopped the program
	mov	eax,[debug_event.Exception.ExceptionCode]
	mov	esi,debug_exception_names
      .find_name:
	mov	edx,[esi]
	add	esi,4
	test	edx,edx
	jz	.name_ok
	cmp	edx,eax
	je	.name_ok
      .skip_name:
	lodsb
	test	al,al
	jnz	.skip_name
	mov	eax,[debug_event.Exception.ExceptionCode]
	jmp	.find_name
      .name_ok:
	mov	ebx,_debug_exception
	cmp	[debug_event.Exception.dwFirstChance],0
	jne	.format
	mov	ebx,_debug_unhandled_exception
      .format:
	cinvoke wsprintf,debug_text,ebx,[debug_event.Exception.ExceptionCode],esi,[debug_event.Exception.ExceptionAddress]
	cmp	[debug_event.Exception.ExceptionCode],0C0000005h
	jne	.done
	cmp	[debug_event.Exception.NumberParameters],2
	jb	.done
	mov	esi,_debug_reading
	cmp	[debug_event.Exception.ExceptionInformation],0
	je	.access_ok
	mov	esi,_debug_writing
	cmp	[debug_event.Exception.ExceptionInformation],1
	je	.access_ok
	mov	esi,_debug_executing
      .access_ok:
	lea	ebx,[debug_text+eax]
	cinvoke wsprintf,ebx,_debug_access,esi,[debug_event.Exception.ExceptionInformation+4]
      .done:
	ret
endp

proc DebugSetStatus text
	invoke	SendMessage,[hwnd_status],SB_SETTEXT,2,[text]
	ret
endp

proc DebugUpdateMenu uses ebx esi, hmenu
; note: enables the commands that are available in the current state of debugger
	mov	esi,[debug_state]
	xor	ebx,ebx
	cmp	esi,DBGS_RUNNING
	sete	bl
	neg	ebx
	and	ebx,MF_GRAYED
	or	ebx,MF_BYCOMMAND
	invoke	EnableMenuItem,[hmenu],IDM_DEBUG,ebx
	invoke	EnableMenuItem,[hmenu],IDM_STEPINTO,ebx
	invoke	EnableMenuItem,[hmenu],IDM_STEPOVER,ebx
	invoke	EnableMenuItem,[hmenu],IDM_RUNTOCURSOR,ebx
	xor	ebx,ebx
	cmp	esi,DBGS_PAUSED
	setne	bl
	neg	ebx
	and	ebx,MF_GRAYED
	or	ebx,MF_BYCOMMAND
	invoke	EnableMenuItem,[hmenu],IDM_STEPOUT,ebx
	xor	ebx,ebx
	cmp	esi,DBGS_RUNNING
	setne	bl
	neg	ebx
	and	ebx,MF_GRAYED
	or	ebx,MF_BYCOMMAND
	invoke	EnableMenuItem,[hmenu],IDM_BREAK,ebx
	xor	ebx,ebx
	cmp	esi,DBGS_NONE
	sete	bl
	neg	ebx
	and	ebx,MF_GRAYED
	or	ebx,MF_BYCOMMAND
	invoke	EnableMenuItem,[hmenu],IDM_STOPDEBUG,ebx
	xor	ebx,ebx
	cmp	[breakpoints_count],0
	sete	bl
	neg	ebx
	and	ebx,MF_GRAYED
	or	ebx,MF_BYCOMMAND
	invoke	EnableMenuItem,[hmenu],IDM_CLEARBREAKPOINTS,ebx
	xor	ebx,ebx
	cmp	[debug_panel_height],0
	setne	bl
	neg	ebx
	and	ebx,MF_CHECKED
	or	ebx,MF_BYCOMMAND
	invoke	CheckMenuItem,[hmenu],IDM_DEBUGPANEL,ebx
	ret
endp

