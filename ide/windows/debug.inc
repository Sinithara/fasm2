proc DebugPanel uses ebx esi edi, hwnd,wmsg,wparam,lparam
; note: the procedure of the window that contains the views of the debugged program
	mov	eax,[wmsg]
	cmp	eax,WM_CREATE
	je	.create
	cmp	eax,WM_SIZE
	je	.size
	cmp	eax,WM_NOTIFY
	je	.notify
	cmp	eax,WM_COMMAND
	je	.command
	cmp	eax,WM_CTLCOLORSTATIC
	je	.color
	invoke	DefWindowProc,[hwnd],[wmsg],[wparam],[lparam]
	ret
      .create:
	mov	ebx,WS_CHILD+WS_VISIBLE+WS_VSCROLL+ES_MULTILINE+ES_READONLY+ES_AUTOVSCROLL+ES_NOHIDESEL
	invoke	CreateWindowEx,WS_EX_STATICEDGE,_edit_class,NULL,WS_CHILD+WS_VISIBLE+ES_MULTILINE+ES_READONLY,0,0,0,0,[hwnd],NULL,[hinstance],NULL
	mov	[hwnd_debug_registers],eax
	invoke	CreateWindowEx,0,_tabctrl_class,NULL,WS_CHILD+WS_VISIBLE+TCS_FOCUSNEVER,0,0,0,0,[hwnd],NULL,[hinstance],NULL
	mov	[hwnd_debug_tabs],eax
	invoke	CreateWindowEx,WS_EX_STATICEDGE,_edit_class,NULL,WS_CHILD+WS_VISIBLE+ES_AUTOHSCROLL,0,0,0,0,[hwnd],NULL,[hinstance],NULL
	mov	[hwnd_debug_address],eax
	invoke	CreateWindowEx,WS_EX_STATICEDGE,_edit_class,NULL,ebx,0,0,0,0,[hwnd],NULL,[hinstance],NULL
	mov	[hwnd_debug_memory],eax
	and	ebx,not WS_VISIBLE
	invoke	CreateWindowEx,WS_EX_STATICEDGE,_edit_class,NULL,ebx,0,0,0,0,[hwnd],NULL,[hinstance],NULL
	mov	[hwnd_debug_stack],eax
	invoke	CreateWindowEx,WS_EX_STATICEDGE,_edit_class,NULL,ebx,0,0,0,0,[hwnd],NULL,[hinstance],NULL
	mov	[hwnd_debug_output],eax
	invoke	SendMessage,[hwnd_debug_output],EM_SETLIMITTEXT,0,0
	invoke	SendMessage,[hwnd_status],WM_GETFONT,0,0
	invoke	SendMessage,[hwnd_debug_tabs],WM_SETFONT,eax,FALSE
	mov	[debug_ei.header.mask],TCIF_TEXT
	mov	esi,_debug_views
	xor	ebx,ebx
      .add_view:
	mov	[debug_ei.header.pszText],esi
	invoke	SendMessage,[hwnd_debug_tabs],TCM_INSERTITEM,ebx,debug_ei
	inc	ebx
      .next_view:
	lodsb
	test	al,al
	jnz	.next_view
	cmp	byte [esi],0
	jne	.add_view
	xor	eax,eax
	ret
      .size:
	xor	eax,eax
	mov	[debug_rc.left],eax
	mov	[debug_rc.top],eax
	mov	[debug_rc.right],eax
	mov	[debug_rc.bottom],eax
	invoke	SendMessage,[hwnd_debug_tabs],TCM_ADJUSTRECT,TRUE,debug_rc
	mov	esi,[debug_rc.bottom]
	sub	esi,[debug_rc.top]			; esi = height of tabs
	invoke	GetClientRect,[hwnd],debug_rc
	mov	ebx,[debug_font_width]
	imul	ebx,28
	add	ebx,12				; ebx = width of the registers view
	invoke	MoveWindow,[hwnd_debug_registers],0,0,ebx,[debug_rc.bottom],TRUE
	add	ebx,2
	sub	[debug_rc.right],ebx
	jns	.width_ok
	and	[debug_rc.right],0
      .width_ok:
	invoke	MoveWindow,[hwnd_debug_tabs],ebx,0,[debug_rc.right],esi,TRUE
	sub	[debug_rc.bottom],esi
	jns	.height_ok
	and	[debug_rc.bottom],0
      .height_ok:
	invoke	MoveWindow,[hwnd_debug_stack],ebx,esi,[debug_rc.right],[debug_rc.bottom],TRUE
	invoke	MoveWindow,[hwnd_debug_output],ebx,esi,[debug_rc.right],[debug_rc.bottom],TRUE
	mov	edi,[debug_font_height]
	add	edi,6
	invoke	MoveWindow,[hwnd_debug_address],ebx,esi,[debug_rc.right],edi,TRUE
	add	esi,edi
	sub	[debug_rc.bottom],edi
	jns	.memory_height_ok
	and	[debug_rc.bottom],0
      .memory_height_ok:
	invoke	MoveWindow,[hwnd_debug_memory],ebx,esi,[debug_rc.right],[debug_rc.bottom],TRUE
	xor	eax,eax
	ret
      .notify:
	mov	ebx,[lparam]
	virtual at ebx
	.nmh	NMHDR
	end	virtual
	cmp	[.nmh.code],TCN_SELCHANGE
	jne	.processed
	invoke	SendMessage,[hwnd_debug_tabs],TCM_GETCURSEL,0,0
	stdcall DebugSelectView,eax
	jmp	.processed
      .command:
	mov	eax,[lparam]
	cmp	eax,[hwnd_debug_address]
	jne	.processed
	mov	eax,[wparam]
	shr	eax,16
	cmp	eax,EN_CHANGE
	jne	.processed
	stdcall DebugUpdateMemory
	jmp	.processed
      .color:
	invoke	GetSysColor,COLOR_WINDOWTEXT
	invoke	SetTextColor,[wparam],eax
	invoke	GetSysColor,COLOR_WINDOW
	invoke	SetBkColor,[wparam],eax
	invoke	GetSysColorBrush,COLOR_WINDOW
	ret
      .processed:
	xor	eax,eax
	ret
endp

proc DebugSelectView uses ebx, view
; note: shows the selected page of the debugger panel
	mov	ebx,[view]
	mov	[debug_view],ebx
	mov	eax,SW_HIDE
	cmp	ebx,DBGV_MEMORY
	jne	.show_memory
	mov	eax,SW_SHOW
      .show_memory:
	push	eax
	invoke	ShowWindow,[hwnd_debug_address],eax
	pop	eax
	invoke	ShowWindow,[hwnd_debug_memory],eax
	mov	eax,SW_HIDE
	cmp	ebx,DBGV_STACK
	jne	.show_stack
	mov	eax,SW_SHOW
      .show_stack:
	invoke	ShowWindow,[hwnd_debug_stack],eax
	mov	eax,SW_HIDE
	cmp	ebx,DBGV_OUTPUT
	jne	.show_output
	mov	eax,SW_SHOW
      .show_output:
	invoke	ShowWindow,[hwnd_debug_output],eax
	ret
endp

proc DebugSetFont uses ebx
; note: applies the font of the editor to the views of the debugger panel
	invoke	SendMessage,[hwnd_debug_registers],WM_SETFONT,[hfont],TRUE
	invoke	SendMessage,[hwnd_debug_address],WM_SETFONT,[hfont],TRUE
	invoke	SendMessage,[hwnd_debug_memory],WM_SETFONT,[hfont],TRUE
	invoke	SendMessage,[hwnd_debug_stack],WM_SETFONT,[hfont],TRUE
	invoke	SendMessage,[hwnd_debug_output],WM_SETFONT,[hfont],TRUE
	invoke	GetDC,[hwnd_debug]
	mov	ebx,eax
	invoke	SelectObject,ebx,[hfont]
	push	eax
	mov	byte [debug_text],20h
	invoke	GetTextExtentPoint32,ebx,debug_text,1,debug_rc
	mov	eax,[debug_rc.left]
	mov	[debug_font_width],eax
	mov	eax,[debug_rc.top]
	mov	[debug_font_height],eax
	pop	eax
	invoke	SelectObject,ebx,eax
	invoke	ReleaseDC,[hwnd_debug],ebx
	cmp	[debug_panel_height],0
	je	.done
	mov	eax,[debug_font_height]
	imul	eax,10
	add	eax,8
	mov	[debug_panel_height],eax
      .done:
	ret
endp

proc DebugShowPanel show
; note: shows or hides the debugger panel
	cmp	[show],FALSE
	je	.hide
	cmp	[debug_panel_height],0
	jne	.done
	mov	[debug_panel_height],1
	stdcall DebugSetFont
	invoke	ShowWindow,[hwnd_debug],SW_SHOW
	jmp	.arrange
      .hide:
	cmp	[debug_panel_height],0
	je	.done
	and	[debug_panel_height],0
	invoke	ShowWindow,[hwnd_debug],SW_HIDE
      .arrange:
	invoke	SendMessage,[hwnd_main],WM_SIZE,0,0
	invoke	SendMessage,[hwnd_debug],WM_SIZE,0,0
      .done:
	ret
endp

proc DebugLog uses ebx esi edi, text
; note: adds a line of text to the output view
	invoke	GetWindowTextLength,[hwnd_debug_output]
	mov	ebx,eax
	cmp	ebx,100000h
	jb	.append
	invoke	SetWindowText,[hwnd_debug_output],_null
	xor	ebx,ebx
      .append:
	; cut off the line break at the end of the text, a proper one is going to be added
	mov	esi,[text]
	call	debug_string_length
      .trim:
	jecxz	.trimmed
	mov	al,[esi+ecx-1]
	cmp	al,0Ah
	je	.cut
	cmp	al,0Dh
	jne	.trimmed
      .cut:
	dec	ecx
	jmp	.trim
      .trimmed:
	mov	edi,ecx
	movzx	eax,byte [esi+edi]
	push	eax
	mov	byte [esi+edi],0
	invoke	SendMessage,[hwnd_debug_output],EM_SETSEL,ebx,ebx
	invoke	SendMessage,[hwnd_debug_output],EM_REPLACESEL,FALSE,esi
	pop	eax
	mov	[esi+edi],al
	invoke	SendMessage,[hwnd_debug_output],EM_SETSEL,-1,-1
	invoke	SendMessage,[hwnd_debug_output],EM_REPLACESEL,FALSE,_debug_line_break
	invoke	SendMessage,[hwnd_debug_output],EM_SCROLLCARET,0,0
	ret
endp

proc DebugClearViews
; note: empties the views when there is no program to show
	invoke	SetWindowText,[hwnd_debug_registers],_null
	invoke	SetWindowText,[hwnd_debug_memory],_null
	invoke	SetWindowText,[hwnd_debug_stack],_null
	ret
endp

proc DebugUpdateViews
; note: fills the views with the current state of the stopped program
	stdcall DebugUpdateRegisters
	stdcall DebugUpdateMemory
	stdcall DebugUpdateStack
	ret
endp

proc DebugUpdateRegisters uses ebx esi edi
	cmp	[debug_state],DBGS_PAUSED
	jne	.done
	mov	edi,debug_arguments
	mov	eax,[debug_context.regEax]
	stosd
	mov	eax,[debug_context.regEbx]
	stosd
	mov	eax,[debug_context.regEcx]
	stosd
	mov	eax,[debug_context.regEdx]
	stosd
	mov	eax,[debug_context.regEsi]
	stosd
	mov	eax,[debug_context.regEdi]
	stosd
	mov	eax,[debug_context.regEbp]
	stosd
	mov	eax,[debug_context.regEsp]
	stosd
	mov	eax,[debug_context.regEip]
	stosd
	mov	eax,[debug_context.regFlag]
	stosd
	mov	esi,debug_flag_bits
	mov	ebx,[debug_context.regFlag]
      .flag:
	lodsb
	cmp	al,-1
	je	.flags_ok
	movzx	ecx,al
	mov	eax,ebx
	shr	eax,cl
	and	eax,1
	stosd
	jmp	.flag
      .flags_ok:
	mov	eax,[debug_context.regCs]
	stosd
	mov	eax,[debug_context.regDs]
	stosd
	mov	eax,[debug_context.regEs]
	stosd
	mov	eax,[debug_context.regSs]
	stosd
	mov	eax,[debug_context.regFs]
	stosd
	mov	eax,[debug_context.regGs]
	stosd
	invoke	wvsprintf,debug_text,_debug_registers,debug_arguments
	invoke	SetWindowText,[hwnd_debug_registers],debug_text
      .done:
	ret
endp

proc DebugUpdateMemory uses ebx esi edi
; note: shows the contents of memory at the address given by the expression typed by user
	cmp	[debug_state],DBGS_PAUSED
	jne	.done
	invoke	GetWindowText,[hwnd_debug_address],debug_expression,100h
	mov	esi,debug_expression
	call	debug_evaluate
	jc	.invalid
	mov	ebx,eax
	mov	edi,debug_text
	mov	[debug_rows],DEBUG_MEMORY_ROWS
      .row:
	mov	eax,ebx
	mov	ecx,8
	call	debug_put_hex
	mov	ax,2020h
	stosw
	push	edi
	mov	esi,ebx
	mov	edi,debug_code
	mov	ecx,16
	call	debug_read_memory
	pop	edi
	jc	.unreadable
	mov	esi,debug_code
	mov	edx,16
      .byte:
	lodsb
	mov	ecx,2
	push	edx
	call	debug_put_hex
	pop	edx
	mov	al,20h
	stosb
	dec	edx
	jnz	.byte
	stosb
	mov	esi,debug_code
	mov	ecx,16
      .character:
	lodsb
	cmp	al,20h
	jb	.replace
	cmp	al,7Fh
	jb	.character_ok
      .replace:
	mov	al,'.'
      .character_ok:
	stosb
	loop	.character
	jmp	.row_done
      .unreadable:
	mov	ecx,16
      .unreadable_byte:
	mov	eax,'?? '
	stosd
	dec	edi
	loop	.unreadable_byte
      .row_done:
	mov	ax,0A0Dh
	stosw
	add	ebx,16
	dec	[debug_rows]
	jnz	.row
	sub	edi,2
	xor	al,al
	stosb
	mov	esi,debug_text
	jmp	.show
      .invalid:
	mov	esi,_debug_memory_hint
	cmp	[debug_expression],0
	je	.show
	mov	esi,_debug_invalid_expression
      .show:
	invoke	SendMessage,[hwnd_debug_memory],EM_GETFIRSTVISIBLELINE,0,0
	mov	ebx,eax
	invoke	SendMessage,[hwnd_debug_memory],WM_SETREDRAW,FALSE,0
	invoke	SetWindowText,[hwnd_debug_memory],esi
	invoke	SendMessage,[hwnd_debug_memory],EM_LINESCROLL,0,ebx
	invoke	SendMessage,[hwnd_debug_memory],WM_SETREDRAW,TRUE,0
	invoke	InvalidateRect,[hwnd_debug_memory],NULL,TRUE
      .done:
	ret
endp

proc DebugUpdateStack uses ebx esi edi
; note: shows the contents of the stack of the stopped thread
	cmp	[debug_state],DBGS_PAUSED
	jne	.done
	mov	ebx,[debug_context.regEsp]
	mov	edi,debug_text
	mov	[debug_rows],DEBUG_STACK_ROWS
      .row:
	push	edi
	mov	esi,ebx
	mov	edi,debug_value
	mov	ecx,4
	call	debug_read_memory
	pop	edi
	jc	.rows_done
	mov	eax,ebx
	mov	ecx,8
	call	debug_put_hex
	mov	ax,2020h
	stosw
	mov	eax,[debug_value]
	mov	ecx,8
	call	debug_put_hex
	cmp	ebx,[debug_context.regEbp]
	jne	.frame_ok
	mov	esi,_debug_stack_frame
	call	debug_put_string
      .frame_ok:
	mov	eax,[debug_value]
	push	edi
	call	debug_check_return_address
	pop	edi
	jc	.not_return_address
	; this value looks like a return address, show the line of source containing the call
	mov	eax,[debug_value]
	dec	eax
	call	debug_find_line
	jnc	.show_line
      .not_return_address:
	; when the value points into the program, show the label that it refers to
	mov	eax,[debug_value]
	push	ebx
	call	debug_find_nearest_symbol
	pop	ebx
	jc	.row_done
	cmp	eax,1000h
	jae	.row_done
	push	eax
	mov	ax,2020h
	stosw
	movzx	ecx,byte [esi+5]
	add	esi,6
	rep	movsb
	pop	eax
	test	eax,eax
	jz	.row_done
	push	eax
	mov	al,'+'
	stosb
	pop	eax
	call	debug_put_short_hex
	jmp	.row_done
      .show_line:
	push	ebx
	mov	ebx,esi
	mov	ax,2020h
	stosw
	invoke	GetFileTitle,[ebx+DebugLine.path],name_buffer,100h
	mov	esi,name_buffer
	call	debug_put_string
	mov	ax,' ['
	stosw
	mov	eax,[ebx+DebugLine.number]
	call	debug_put_decimal
	mov	al,']'
	stosb
	pop	ebx
      .row_done:
	mov	ax,0A0Dh
	stosw
	add	ebx,4
	dec	[debug_rows]
	jnz	.row
      .rows_done:
	xor	al,al
	stosb
	invoke	SetWindowText,[hwnd_debug_stack],debug_text
      .done:
	ret
endp

debug_put_hex:
; in: eax = value, ecx = number of digits, edi - buffer
; out: edi - end of the stored digits
; preserves: ebx, esi
	mov	edx,eax
	push	ecx
	shl	ecx,2
	ror	edx,cl
	pop	ecx
      .digit:
	rol	edx,4
	mov	al,dl
	and	al,0Fh
	cmp	al,10
	sbb	al,69h
	das
	stosb
	loop	.digit
	retn

debug_put_short_hex:
; in: eax = value, edi - buffer
; out: edi - end of the stored digits
; preserves: ebx, esi
	mov	ecx,8
	mov	edx,eax
      .count:
	cmp	ecx,1
	je	debug_put_hex
	test	edx,0F0000000h
	jnz	debug_put_hex
	shl	edx,4
	dec	ecx
	jmp	.count

debug_put_decimal:
; in: eax = value, edi - buffer
; out: edi - end of the stored digits
; preserves: ebx, esi
	xor	ecx,ecx
      .divide:
	xor	edx,edx
	push	ebx
	mov	ebx,10
	div	ebx
	pop	ebx
	push	edx
	inc	ecx
	test	eax,eax
	jnz	.divide
      .digit:
	pop	eax
	add	al,'0'
	stosb
	loop	.digit
	retn

debug_put_string:
; in: esi - ASCIIZ string, edi - buffer
; out: edi - end of the copied text
; preserves: ebx, ecx, edx
      .copy:
	lodsb
	test	al,al
	jz	.done
	stosb
	jmp	.copy
      .done:
	retn

; ----------------------------------------------------------------------------
;  expressions
; ----------------------------------------------------------------------------

debug_evaluate:
; in: esi - ASCIIZ text of expression
; out: cf set when the expression is not valid, otherwise eax = value
; note:
;  the expression may consist of numbers (hexadecimal), names of registers, labels defined by the program,
;  operators +, -, * and parentheses; square brackets give the value stored in memory at the enclosed address,
;  they may be preceded with a size operator (byte, word or dword)
	mov	[debug_evaluation_depth],0
	call	debug_evaluate_sum
	jc	.invalid
	call	debug_skip_spaces
	cmp	byte [esi],0
	jne	.invalid
	clc
	retn
      .invalid:
	stc
	retn

debug_skip_spaces:
; preserves: all registers except esi and flags
	cmp	byte [esi],20h
	je	.skip
	cmp	byte [esi],9
	jne	.done
      .skip:
	inc	esi
	jmp	debug_skip_spaces
      .done:
	retn

debug_evaluate_sum:
	inc	[debug_evaluation_depth]
	cmp	[debug_evaluation_depth],32
	ja	.invalid
	call	debug_evaluate_product
	jc	.invalid
      .next:
	call	debug_skip_spaces
	cmp	byte [esi],'+'
	je	.add
	cmp	byte [esi],'-'
	je	.subtract
	dec	[debug_evaluation_depth]
	clc
	retn
      .add:
	inc	esi
	push	eax
	call	debug_evaluate_product
	pop	edx
	jc	.invalid
	add	eax,edx
	jmp	.next
      .subtract:
	inc	esi
	push	eax
	call	debug_evaluate_product
	pop	edx
	jc	.invalid
	sub	edx,eax
	mov	eax,edx
	jmp	.next
      .invalid:
	dec	[debug_evaluation_depth]
	stc
	retn

debug_evaluate_product:
	call	debug_evaluate_term
	jc	.invalid
      .next:
	call	debug_skip_spaces
	cmp	byte [esi],'*'
	je	.multiply
	clc
	retn
      .multiply:
	inc	esi
	push	eax
	call	debug_evaluate_term
	pop	edx
	jc	.invalid
	imul	eax,edx
	jmp	.next
      .invalid:
	stc
	retn

debug_evaluate_term:
	call	debug_skip_spaces
	mov	al,[esi]
	cmp	al,'('
	je	.enclosed
	cmp	al,'['
	je	.dword_in_memory
	cmp	al,'-'
	je	.negated
	cmp	al,'+'
	je	.positive
	; copy the name or number, keeping also a variant converted to lower case
	mov	edi,debug_token
	mov	ecx,DEBUG_TOKEN_LENGTH-1
      .copy:
	lodsb
	call	.is_symbol_character
	jc	.copied
	mov	[edi+DEBUG_TOKEN_LENGTH],al
	cmp	al,'A'
	jb	.store
	cmp	al,'Z'
	ja	.store
	or	al,20h
      .store:
	stosb
	loop	.copy
	jmp	.invalid
      .copied:
	dec	esi
	xor	al,al
	mov	[edi+DEBUG_TOKEN_LENGTH],al
	stosb
	cmp	edi,debug_token+1
	je	.invalid
	mov	edx,debug_token
	; is it a size operator?
	mov	ecx,1
	cmp	dword [edx],'byte'
	jne	.not_byte
	cmp	byte [edx+4],0
	je	.sized_memory
      .not_byte:
	mov	ecx,2
	cmp	dword [edx],'word'
	jne	.not_word
	cmp	byte [edx+4],0
	je	.sized_memory
      .not_word:
	mov	ecx,4
	cmp	dword [edx],'dwor'
	jne	.not_dword
	cmp	word [edx+4],'d'
	je	.sized_memory
      .not_dword:
	; is it a register?
	cmp	[debug_state],DBGS_PAUSED
	jne	.not_register
	mov	ebx,debug_register_names
      .check_register:
	cmp	byte [ebx],0
	je	.not_register
	push	esi
	mov	esi,ebx
	mov	edi,edx
      .compare_register:
	lodsb
	scasb
	jne	.next_register
	test	al,al
	jnz	.compare_register
	pop	edi
	xchg	esi,edi
	movzx	ebx,word [edi]		; offset within CONTEXT
	movzx	ecx,byte [edi+2]	; size
	movzx	edx,byte [edi+3]	; position
	mov	eax,dword [debug_context+ebx]
	xchg	ecx,edx
	shr	eax,cl
	cmp	edx,4
	je	.valid
	movzx	eax,ax
	cmp	edx,2
	je	.valid
	movzx	eax,al
	jmp	.valid
      .next_register:
	pop	esi
      .skip_register:
	inc	ebx
	cmp	byte [ebx-1],0
	jne	.skip_register
	add	ebx,4
	jmp	.check_register
      .not_register:
	; is it a label?
	push	esi
	mov	esi,debug_name
	call	debug_find_symbol
	pop	esi
	jnc	.valid
	; it must be a number then
	mov	ebx,debug_token
	cmp	word [ebx],'0x'
	jne	.number
	add	ebx,2
      .number:
	xor	edx,edx
	xor	ecx,ecx
      .digit:
	mov	al,[ebx]
	inc	ebx
	test	al,al
	jz	.number_done
	cmp	al,'h'
	je	.number_suffix
	sub	al,'0'
	jc	.invalid
	cmp	al,10
	jb	.digit_ok
	sub	al,'a'-'0'
	jc	.invalid
	add	al,10
	cmp	al,16
	jae	.invalid
      .digit_ok:
	test	edx,0F0000000h
	jnz	.invalid
	shl	edx,4
	or	dl,al
	inc	ecx
	jmp	.digit
      .number_suffix:
	cmp	byte [ebx],0
	jne	.invalid
      .number_done:
	jecxz	.invalid
	mov	eax,edx
      .valid:
	clc
	retn
      .enclosed:
	inc	esi
	call	debug_evaluate_sum
	jc	.invalid
	call	debug_skip_spaces
	cmp	byte [esi],')'
	jne	.invalid
	inc	esi
	clc
	retn
      .negated:
	inc	esi
	call	debug_evaluate_term
	jc	.invalid
	neg	eax
	clc
	retn
      .positive:
	inc	esi
	jmp	debug_evaluate_term
      .sized_memory:
	call	debug_skip_spaces
	cmp	byte [esi],'['
	je	.memory
	jmp	.invalid
      .dword_in_memory:
	mov	ecx,4
      .memory:
	inc	esi
	push	ecx
	call	debug_evaluate_sum
	pop	ecx
	jc	.invalid
	call	debug_skip_spaces
	cmp	byte [esi],']'
	jne	.invalid
	inc	esi
	cmp	[debug_state],DBGS_PAUSED
	jne	.invalid
	push	esi
	mov	esi,eax
	mov	edi,debug_evaluation_buffer
	and	dword [edi],0
	call	debug_read_memory
	pop	esi
	jc	.invalid
	mov	eax,[debug_evaluation_buffer]
	clc
	retn
      .invalid:
	stc
	retn
      .is_symbol_character:
	; out: cf set when the character in al cannot be a part of a name
	push	edi ecx
	mov	edi,debug_separators
	mov	ecx,debug_separators.count
	repne	scasb
	pop	ecx edi
	je	.separator
	clc
	retn
      .separator:
	stc
	retn

debug_find_symbol:
; in: esi - name
; out: cf set when there is no such label, otherwise eax = address in the memory of the debugged program
; preserves: esi
	cmp	[debug_info_ready],0
	je	.not_found
	call	debug_string_length
	cmp	ecx,100h
	jae	.not_found
	mov	edx,ecx 			; dl = length of name
	xor	dh,dh				; at first the exact name is looked for, then the case is ignored
      .search:
	mov	ebx,[debug_symbols]
	mov	edi,[debug_symbols_size]
	add	edi,ebx
      .check:
	cmp	ebx,edi
	jae	.searched
	movzx	ecx,byte [ebx+5]
	cmp	cl,dl
	jne	.next
	push	esi edi
	lea	edi,[ebx+6]
      .compare:
	lodsb
	mov	ah,[edi]
	inc	edi
	or	al,dh
	or	ah,dh
	cmp	al,ah
	jne	.compared
	dec	ecx
	jnz	.compare
      .compared:
	pop	edi esi
	jne	.next
	mov	eax,[ebx]
	test	byte [ebx+4],1
	jz	.found
	; a relocatable value is a valid address only when it lies within the image of the program
	sub	eax,[debug_preferred_base]
	cmp	eax,[debug_image_size]
	jae	.next
	add	eax,[debug_image_base]
	clc
	retn
      .next:
	movzx	ecx,byte [ebx+5]
	lea	ebx,[ebx+ecx+6]
	jmp	.check
      .searched:
	test	dh,dh
	jnz	.not_found
	mov	dh,20h
	jmp	.search
      .found:
	call	debug_relocate
	clc
	retn
      .not_found:
	stc
	retn

debug_relocate:
; in: eax = address as assumed by the assembler
; out: eax = corresponding address in the memory of the debugged program
; preserves: ebx, ecx, edx, esi, edi
	push	eax
	sub	eax,[debug_preferred_base]
	cmp	eax,[debug_image_size]
	pop	eax
	jae	.done
	sub	eax,[debug_preferred_base]
	add	eax,[debug_image_base]
      .done:
	retn

debug_find_nearest_symbol:
; in: eax = address in the memory of the debugged program
; out:
;  cf set when the address is not within the image of the program or there is no label that would precede it
;  when cf = 0:
;   esi - record of the label (value, flags, length of name, name)
;   eax = offset relative to the label
; preserves: edi
	cmp	[debug_info_ready],0
	je	.not_found
	sub	eax,[debug_image_base]
	cmp	eax,[debug_image_size]
	jae	.not_found
	add	eax,[debug_preferred_base]
	xor	esi,esi
	mov	ebx,[debug_symbols]
	mov	edx,[debug_symbols_size]
	add	edx,ebx
      .check:
	cmp	ebx,edx
	jae	.checked
	mov	ecx,[ebx]
	cmp	ecx,eax
	ja	.next
	test	esi,esi
	jz	.better
	cmp	ecx,[esi]
	jbe	.next
      .better:
	mov	esi,ebx
      .next:
	movzx	ecx,byte [ebx+5]
	lea	ebx,[ebx+ecx+6]
	jmp	.check
      .checked:
	test	esi,esi
	jz	.not_found
	mov	ecx,[esi]
	sub	ecx,[debug_preferred_base]
	cmp	ecx,[debug_image_size]
	jae	.not_found
	sub	eax,[esi]
	clc
	retn
      .not_found:
	stc
	retn
